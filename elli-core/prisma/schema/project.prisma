model Project {
  id                   String  @id
  name                 String
  description          String
  jobNumber            String? @unique
  contractNumber       String?
  fieldwireProjectId   String? @unique
  fieldwireProjectName String?

  stage      Lookup        @relation(fields: [stageId], references: [id], name: "project_stage")
  stageId    String
  division   Lookup        @relation(fields: [divisionId], references: [id], name: "project_division")
  divisionId String
  status     ProjectStatus

  streetAddress String?
  city          String?
  state         String?
  zipCode       String?

  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?

  gc       GeneralContractor @relation(fields: [gcId], references: [id])
  gcId     String
  leadPM   Employee?         @relation(fields: [leadPMId], references: [id])
  leadPMId String?

  contractValue       Decimal
  contractType        String?
  retainagePercent    Decimal?      @db.Decimal(5, 2)
  targetBudgetPercent Decimal?      @db.Decimal(5, 2)
  taxRate             Decimal?      @default(0) @db.Decimal(5, 2)
  paymentTerms        PaymentTerms?

  actualStartDate      DateTime?
  actualCompletionDate DateTime?
  closedDate           DateTime?
  setInactiveDate      DateTime?
  tcoDate              DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teamMembers                ProjectTeamMember[]
  primeContract              PrimeContract[]
  projectMasterSchedules     ProjectMasterSchedule[]
  projectSchedules           ProjectSchedule[]
  primeChangeOrders          PrimeChangeOrder[]
  primeChangeOrderSyncStatus PrimeChangeOrderSyncStatus?
  primeChangeOrderSyncRuns   PrimeChangeOrderSyncRun[]
  fieldwireProjectUsers      FieldwireProjectUser[]

  rfqs            RFQ[]
  purchaseOrders  PurchaseOrder[]
  subChangeOrders SubChangeOrder[]
  invoices        Invoice[]

  @@index([stageId])
  @@index([status])
  @@index([gcId])
  @@index([leadPMId])
  @@index([fieldwireProjectId])
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  CLOSED
  COMPLETED
}

model ProjectTeamMember {
  employeeId String
  projectId  String
  role       String
  isLead     Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([employeeId, projectId])
  @@index([projectId])
}

model PrimeContract {
  id         String   @id
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  fileId     String
  file       File     @relation(fields: [fileId], references: [id])
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@unique([projectId, fileId])
  @@index([projectId])
  @@index([projectId, isPrimary])
}

model ProjectMasterSchedule {
  id          String   @id
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId   String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  fileId      String
  fileName    String
  displayName String?
  mimeType    String?
  size        Int?
  objectId    String?
  uploadedAt  DateTime @default(now())
  createdBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([fileId])
  @@index([deletedAt])
}
model ProjectSchedule {
  id                 String            @id
  project            Project           @relation(fields: [projectId], references: [id])
  projectId          String
  date               DateTime
  description        String
  adjustedFinishDate DateTime?
  notes              String?
  file               File?             @relation(fields: [fileId], references: [id])
  fileId             String?           @unique
  primeChangeOrder   PrimeChangeOrder? @relation(fields: [primeChangeOrderId], references: [id], onDelete: Restrict)
  primeChangeOrderId String?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([projectId])
  @@index([primeChangeOrderId])
}
