{
    "paths": {
        "/gc": {
            "get": {
                "tags": ["General Contractors"],
                "summary": "List general contractors (paginated)",
                "operationId": "listGcs",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25, "maximum": 100 } },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" } },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } },
                    { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by GC name" },
                    { "name": "gcTypeId", "in": "query", "schema": { "type": "string" }, "description": "Filter by GC type lookup ULID" },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] } }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of general contractors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "array", "items": { "$ref": "#/components/schemas/GeneralContractor" } },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires generalContractor:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "post": {
                "tags": ["General Contractors"],
                "summary": "Create a general contractor",
                "operationId": "createGc",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GcCreateRequest" } } }
                },
                "responses": {
                    "201": {
                        "description": "GC created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "GC type not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "put": {
                "tags": ["General Contractors"],
                "summary": "Update a general contractor (full replace)",
                "operationId": "updateGc",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GcUpdateRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "GC updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "GC or GC type not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/gc/{id}": {
            "get": {
                "tags": ["General Contractors"],
                "summary": "Get a general contractor by ID",
                "operationId": "getGc",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "GC ULID" }
                ],
                "responses": {
                    "200": {
                        "description": "GC details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "GC not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["General Contractors"],
                "summary": "Delete a general contractor (soft delete)",
                "operationId": "deleteGc",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "GC ULID" }
                ],
                "responses": {
                    "200": { "description": "GC deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "GC not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/gc/document/add": {
            "patch": {
                "tags": ["General Contractors"],
                "summary": "Link a document (file) to a general contractor",
                "operationId": "addDocumentToGc",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddGcDocumentRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Document linked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GcDocument" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "GC or file not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "Document already linked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/gc/document/update": {
            "patch": {
                "tags": ["General Contractors"],
                "summary": "Update a GC document (e.g. expiry)",
                "operationId": "updateGcDocument",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateGcDocumentRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Document updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GcDocument" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "GC document not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/gc/document/remove": {
            "patch": {
                "tags": ["General Contractors"],
                "summary": "Unlink a document from a general contractor",
                "operationId": "removeDocumentFromGc",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemoveGcDocumentRequest" } } }
                },
                "responses": {
                    "200": { "description": "Document unlinked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "GC document not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "GeneralContractor": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "name": { "type": "string" },
                    "gcTypeId": { "type": "string" },
                    "gcType": { "description": "Lookup row for the GC type; included on get/list responses", "nullable": true },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "format": "uri", "nullable": true },
                    "fax": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "retainagePercent": { "type": "number" },
                    "contacts": {
                        "type": "array",
                        "description": "Contacts belonging to this GC; included on get/list responses",
                        "items": { "$ref": "#/components/schemas/Contact" }
                    },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
                }
            },
            "GcDocument": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "gcId": { "type": "string" },
                    "fileId": { "type": "string" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "GcCreateRequest": {
                "type": "object",
                "required": ["name", "gcTypeId"],
                "properties": {
                    "name": { "type": "string", "minLength": 2 },
                    "gcTypeId": { "type": "string", "description": "GC type lookup ULID" },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "format": "uri", "nullable": true },
                    "fax": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"], "default": "NET_30" },
                    "retainagePercent": { "type": "number", "minimum": 0, "maximum": 100, "default": 10 }
                }
            },
            "GcUpdateRequest": {
                "allOf": [
                    { "$ref": "#/components/schemas/GcCreateRequest" },
                    {
                        "type": "object",
                        "required": ["id"],
                        "properties": { "id": { "type": "string", "description": "GC ULID" } }
                    }
                ]
            },
            "AddGcDocumentRequest": {
                "type": "object",
                "required": ["gcId", "fileId"],
                "properties": {
                    "gcId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true }
                }
            },
            "UpdateGcDocumentRequest": {
                "type": "object",
                "required": ["gcId", "fileId"],
                "properties": {
                    "gcId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true }
                }
            },
            "RemoveGcDocumentRequest": {
                "type": "object",
                "required": ["gcId", "fileId"],
                "properties": {
                    "gcId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" }
                }
            }
        }
    }
}
