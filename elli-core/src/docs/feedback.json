{
    "paths": {
        "/feedback": {
            "get": {
                "tags": ["Feedback"],
                "summary": "Get feedback board columns",
                "operationId": "getFeedbackBoard",
                "responses": {
                    "200": {
                        "description": "Feedback board columns",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/FeedbackBoardResult"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "500": {
                        "description": "Feedback destination is unavailable or not configured",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": ["Feedback"],
                "summary": "Submit app feedback to the configured Notion feedback board",
                "operationId": "submitFeedback",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/FeedbackSubmitRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Feedback submitted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/FeedbackSubmitResult"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid feedback payload",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "429": {
                        "description": "Feedback destination is rate limited",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "500": {
                        "description": "Feedback destination is unavailable or not configured",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/feedback/{id}": {
            "get": {
                "tags": ["Feedback"],
                "summary": "Get feedback detail",
                "operationId": "getFeedbackDetail",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Feedback detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/FeedbackDetailResult"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing feedback id",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "500": {
                        "description": "Feedback destination is unavailable or not configured",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FeedbackSubmitRequest": {
                "type": "object",
                "required": ["message"],
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000
                    },
                    "currentUrl": {
                        "type": "string",
                        "format": "uri"
                    },
                    "userAgent": {
                        "type": "string",
                        "maxLength": 1000
                    },
                    "files[]": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                            "type": "string",
                            "format": "binary"
                        }
                    }
                }
            },
            "FeedbackSubmitResult": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "notionPageId": { "type": "string" },
                    "notionUrl": { "type": "string", "format": "uri" }
                }
            },
            "FeedbackBoardItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "string" },
                    "url": { "type": "string", "format": "uri" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "FeedbackBoardColumn": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "string" },
                    "items": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/FeedbackBoardItem" }
                    }
                }
            },
            "FeedbackBoardResult": {
                "type": "object",
                "properties": {
                    "columns": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/FeedbackBoardColumn" }
                    }
                }
            },
            "FeedbackDetailContentBlock": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string" },
                    "text": { "type": "string" },
                    "checked": { "type": "boolean" },
                    "children": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/FeedbackDetailContentBlock" }
                    }
                }
            },
            "FeedbackDetailAttachment": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "url": { "type": "string", "format": "uri" },
                    "type": { "type": "string" },
                    "caption": { "type": "string" }
                }
            },
            "FeedbackDetailResult": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "string" },
                    "url": { "type": "string", "format": "uri" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "content": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/FeedbackDetailContentBlock" }
                    },
                    "attachments": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/FeedbackDetailAttachment" }
                    }
                }
            }
        }
    }
}
