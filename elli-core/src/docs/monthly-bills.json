{
    "paths": {
        "/monthly-bills": {
            "get": {
                "tags": ["Monthly Bills"],
                "summary": "List outstanding purchase-order bills for a month, grouped by project",
                "description": "Returns open purchase orders plus purchase orders paid inside the selected reporting window (issued on or before endDate), grouped by project. Each bill row carries its original amount, total paid, remaining balance, the planned payment for the given month/year, and the payments already made. Results are scoped by the caller's role (taken from the auth session, not the query): accountants/admins see all eligible POs, PMs see only POs on projects where they are the Lead PM or PM.",
                "operationId": "listMonthlyBills",
                "parameters": [
                    { "name": "startDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" }, "description": "Start of the reporting window (YYYY-MM-DD)" },
                    { "name": "endDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" }, "description": "End of the reporting window; only POs issued on or before this date are included (YYYY-MM-DD)" },
                    { "name": "month", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1, "maximum": 12 }, "description": "Month (1-12) used to match the planned payment" },
                    { "name": "year", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "Year used to match the planned payment" }
                ],
                "responses": {
                    "200": {
                        "description": "Outstanding bills grouped by project",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "array", "items": { "$ref": "#/components/schemas/MonthlyBillProjectGroup" } }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error (invalid date, month, or year)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized (role not permitted to access this data)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires purchaseOrder:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/monthly-bills/planned-payment": {
            "put": {
                "tags": ["Monthly Bills"],
                "summary": "Create or update a planned payment for a (PO, month, year)",
                "description": "Upserts the planned payment for a purchase order in the current month/year only. If no planned payment exists for that combination it is created, otherwise the amount (and optionally isReady) is updated. Previous months are historical/read-only. Admins/accountants can update any current-month bill; PMs can update current-month bills only for projects where they are the Lead PM or PM.",
                "operationId": "upsertPlannedPayment",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpsertPlannedPaymentRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Planned payment created or updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PlannedPOPayment" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error or non-current month/year", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires monthlyBills:update and valid project scope for PM users)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Purchase order not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/monthly-bills/mark-payment": {
            "patch": {
                "tags": ["Monthly Bills"],
                "summary": "Record a ready planned payment as a QuickBooks payment",
                "description": "Takes a current-month planned payment that is marked isReady and records it as a standalone Check Purchase in QuickBooks (against the supplied synced vendor, bank account, and expense category), then persists a PoPayment with the resulting QuickBooks transaction id/url and clears the planned payment's isReady flag to prevent double payment. Previous months are historical/read-only. Restricted to admins and accountants.",
                "operationId": "markPayment",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarkPaymentRequest" } } }
                },
                "responses": {
                    "201": {
                        "description": "Payment recorded in QuickBooks and persisted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PoPayment" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error, non-current month/year, planned payment not ready, or QuickBooks payment failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires purchaseOrder:update; only admin/accountant)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Planned payment not found, or QuickBooks not connected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MonthlyBillProjectGroup": {
                "type": "object",
                "properties": {
                    "project": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string", "description": "ULID" },
                            "name": { "type": "string" },
                            "jobNumber": { "type": "string", "nullable": true }
                        }
                    },
                    "bills": { "type": "array", "items": { "$ref": "#/components/schemas/MonthlyBillItem" } }
                }
            },
            "MonthlyBillItem": {
                "type": "object",
                "properties": {
                    "purchaseOrder": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string", "description": "ULID" },
                            "poNumber": { "type": "string" },
                            "vendor": {
                                "type": "object",
                                "properties": {
                                    "id": { "type": "string" },
                                    "name": { "type": "string" }
                                }
                            },
                            "issuedAt": { "type": "string", "format": "date-time", "nullable": true }
                        }
                    },
                    "original": { "type": "string", "description": "Original PO total (decimal string)" },
                    "balance": { "type": "string", "description": "Remaining balance: original minus totalPaid (decimal string)" },
                    "totalPaid": { "type": "string", "description": "Sum of payments made against the PO (decimal string)" },
                    "plannedPayment": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "amount": { "type": "string", "description": "Planned payment amount for the month (decimal string)" },
                            "isReady": { "type": "boolean" }
                        }
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "txnDate": { "type": "string", "format": "date-time" },
                                "transactionId": { "type": "string" },
                                "transactionUrl": { "type": "string" }
                            }
                        }
                    }
                }
            },
            "UpsertPlannedPaymentRequest": {
                "type": "object",
                "required": ["purchaseOrderId", "month", "year", "amount"],
                "properties": {
                    "purchaseOrderId": { "type": "string", "description": "Purchase order ID" },
                    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                    "year": { "type": "integer" },
                    "amount": { "type": "number", "minimum": 0, "description": "Planned payment amount" },
                    "isReady": { "type": "boolean", "description": "Whether the planned payment is ready to be paid (defaults to false on create)" }
                }
            },
            "MarkPaymentRequest": {
                "type": "object",
                "required": ["purchaseOrderId", "month", "year", "qbVendorId", "bankAccountId", "categoryId"],
                "properties": {
                    "purchaseOrderId": { "type": "string", "description": "Purchase order ID" },
                    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                    "year": { "type": "integer" },
                    "qbVendorId": { "type": "string", "description": "QuickBooks vendor (payee) id from the synced payee list" },
                    "bankAccountId": { "type": "string", "description": "QuickBooks bank account id from the synced bank-account list" },
                    "categoryId": { "type": "string", "description": "QuickBooks expense account id from the synced line-item category list" },
                    "printLater": { "type": "boolean", "default": false, "description": "When true, marks the QuickBooks check as Print Later / Needs Print" }
                }
            },
            "PlannedPOPayment": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "purchaseOrderId": { "type": "string" },
                    "amount": { "type": "string", "description": "Decimal string" },
                    "isReady": { "type": "boolean" },
                    "month": { "type": "integer" },
                    "year": { "type": "integer" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "PoPayment": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "purchaseOrderId": { "type": "string" },
                    "amount": { "type": "string", "description": "Decimal string" },
                    "qbVendorId": { "type": "string", "description": "QuickBooks vendor id" },
                    "bankAccountId": { "type": "string", "description": "QuickBooks bank account id" },
                    "txnDate": { "type": "string", "format": "date" },
                    "transactionId": { "type": "string", "description": "QuickBooks Purchase transaction id" },
                    "transactionUrl": { "type": "string", "description": "Deep link to the QuickBooks transaction" },
                    "quickBooksResponse": {
                        "type": "object",
                        "nullable": true,
                        "additionalProperties": true,
                        "description": "Raw parsed QuickBooks API response returned when the payment transaction was created"
                    },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            }
        }
    }
}
