{
    "openapi": "3.0.3",
    "info": {
        "title": "Elli Core API",
        "description": "Core API for the Elli application",
        "version": "0.1.0",
        "contact": {
            "name": "Mohammed Yasim",
            "email": "yasim@azba.in"
        }
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "security": [
        {
            "cookieAuth": []
        }
    ],
    "paths": {},
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "better-auth.session_token",
                "description": "Session cookie set by Better-Auth after sign-in"
            }
        },
        "schemas": {
            "SuccessResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "OK" },
                    "path": { "type": "string", "example": "/api/v1/cost-code" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "timeElapsed": { "type": "string", "example": "12.34 ms" }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string" },
                    "details": { "type": "object", "nullable": true },
                    "path": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" }
                }
            },
            "PaginationInfo": {
                "type": "object",
                "properties": {
                    "currentPage": { "type": "integer", "example": 1 },
                    "totalPages": { "type": "integer", "example": 5 },
                    "hasNextPage": { "type": "boolean" },
                    "hasPreviousPage": { "type": "boolean" },
                    "totalItems": { "type": "integer", "example": 120 },
                    "itemsPerPage": { "type": "integer", "example": 25 }
                }
            }
        }
    },
    "tags": [
        { "name": "Auth", "description": "Authentication (Better Auth)" },
        { "name": "Users", "description": "User and role management" },
        { "name": "Cost Code Categories", "description": "Manage cost code categories" },
        { "name": "Cost Codes", "description": "Manage cost codes" },
        { "name": "File", "description": "File and folder management (S3)" },
        { "name": "Employees", "description": "Employee management and project assignments" },
        { "name": "Departments", "description": "Department management and employee assignments" },
        { "name": "Lookup", "description": "Generic lookup values (categories, tags, statuses, etc.)" },
        { "name": "Prime Change Orders", "description": "Fieldwire-synced project Prime Change Orders" }
    ]
}
