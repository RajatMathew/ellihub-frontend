{
    "paths": {
        "/seed/run": {
            "post": {
                "tags": ["Seeder"],
                "summary": "Run all seed scripts",
                "description": "Kicks off the seed scripts (root folder, cost codes, professional roles, vendor types, GC types) in the background and returns immediately with 202. Seeders run in-process, sequentially. Output is logged to the API server's stdout/stderr. Does NOT include the user seeder — use `POST /seed/user` for that. Gated by the `x-seed-key` header which must match the `SEED_API_KEY` env var. If `SEED_API_KEY` is unset, the endpoint is disabled.",
                "operationId": "runSeeders",
                "parameters": [
                    {
                        "name": "x-seed-key",
                        "in": "header",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Shared secret matching SEED_API_KEY"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Seeders accepted and running in background",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/SeederRunAccepted" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid seed key",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    },
                    "403": {
                        "description": "Seeder endpoint disabled (SEED_API_KEY not set)",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    }
                }
            }
        },
        "/seed/reset": {
            "post": {
                "tags": ["Seeder"],
                "summary": "Reset the database",
                "description": "Runs `prisma migrate reset --force --skip-seed` in a background subprocess. Drops all data, re-applies migrations, and does NOT run seeders. Returns 202 immediately. Subprocess output is logged to the API server's stdout/stderr. Gated by the `x-seed-key` header which must match the `SEED_API_KEY` env var. DESTRUCTIVE — intended for non-production environments only.",
                "operationId": "resetDatabase",
                "parameters": [
                    {
                        "name": "x-seed-key",
                        "in": "header",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Shared secret matching SEED_API_KEY"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "DB reset accepted and running in background",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": { "type": "string", "enum": ["started"] }
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid seed key",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    },
                    "403": {
                        "description": "Seeder endpoint disabled (SEED_API_KEY not set)",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    }
                }
            }
        },
        "/seed/user": {
            "post": {
                "tags": ["Seeder"],
                "summary": "Create the default admin user",
                "description": "Runs the user seeder in the background (creates an admin user and default organization). Returns 202 immediately. Output is logged to the API server's stdout/stderr. Gated by the `x-seed-key` header which must match the `SEED_API_KEY` env var.",
                "operationId": "runUserSeeder",
                "parameters": [
                    {
                        "name": "x-seed-key",
                        "in": "header",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Shared secret matching SEED_API_KEY"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "User seeder accepted and running in background",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": { "type": "string", "enum": ["started"] }
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid seed key",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    },
                    "403": {
                        "description": "Seeder endpoint disabled (SEED_API_KEY not set)",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "SeederRunAccepted": {
                "type": "object",
                "properties": {
                    "status": { "type": "string", "enum": ["started"] },
                    "scripts": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Names of seed scripts that will run, in order"
                    }
                }
            }
        }
    }
}
