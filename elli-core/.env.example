# =============================================================================
# Application (API) — required at runtime
# =============================================================================

# PostgreSQL connection string (used by Prisma and app).
# When running in Docker with compose: use service name "db" as host.
DATABASE_URL="postgresql://postgres:password@localhost:13333/ellinew?schema=public"

# Public URL of this API (used by better-auth callbacks, links).
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Allowed frontend origin (CORS, better-auth trustedOrigins).
CLIENT_URL="http://localhost:5173"

# Node environment: development | production
NODE_ENV="production"

# Port the API listens on inside the container (default 3000).
PORT="3000"

# =============================================================================
# Docker Compose / Dokploy — used by docker-compose.yml only
# Set these in Dokploy project/env vars or in .env when running compose.
# =============================================================================

# Postgres (db service)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="postgres"
POSTGRES_PORT="5432"
# API (api service) — host port mapped to container PORT
API_PORT="3000"

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# =============================================================================
# PDF Engine
# =============================================================================

# Internal URL for the FastAPI pdf-engine service.
# Local: http://127.0.0.1:8000
# Docker network: http://pdf-engine:8000
PDF_ENGINE_URL="http://127.0.0.1:8000"
PDF_ENGINE_API_KEY_HEADER="X-API-Key"
# Comma-separated keys accepted by the pdf-engine service.
PDF_ENGINE_API_KEYS="local-dev-key"
# Key sent by this API to the pdf-engine service. Defaults to the first
# PDF_ENGINE_API_KEYS value if omitted.
PDF_ENGINE_API_KEY="local-dev-key"

# Fieldwire API token used to sync Prime Change Orders.
FIELDWIRE_API_TOKEN=""

# =============================================================================
# QuickBooks Online
# =============================================================================

# Create an app at developer.intuit.com and register this callback URI there.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/v1/integrations/quickbooks/callback"
# sandbox | production
QUICKBOOKS_ENVIRONMENT="sandbox"
QUICKBOOKS_MINOR_VERSION="75"
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=""

# =============================================================================
# Microsoft Graph Mail
# =============================================================================

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_ALLOWED_SENDERS=sales@ellicorp.com,bidding@ellicorp.com,procurement@ellicorp.com
MAIL_ALLOW_CUSTOM_SENDER=true
MAIL_ASSET_DIR=src/modules/mail/assets
MAIL_TEMPLATE_DIR=src/modules/mail/templates
