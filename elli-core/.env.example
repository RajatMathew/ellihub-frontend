# =============================================================================
# Core Application
# =============================================================================

# PostgreSQL connection string (Prisma + app runtime).
# Docker compose: use service name "db" as host.
DATABASE_URL="postgresql://postgres:password@localhost:5432/elli?schema=public"

# Public URL of this API (better-auth callbacks, CORS origin).
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Allowed frontend origin (CORS, better-auth trustedOrigins).
CLIENT_URL="http://localhost:5173"

# Node environment: development | production
NODE_ENV="development"

# Port the API listens on (default 3000).
PORT="3000"

# Redis connection URL (caching, scheduler).
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Docker Compose / Dokploy
# =============================================================================

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="elli"
POSTGRES_PORT="5432"
API_PORT="3000"

# =============================================================================
# S3 Object Storage (file uploads)
# =============================================================================

S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""

# =============================================================================
# PDF Engine
# =============================================================================

# Internal URL for the FastAPI pdf-engine service.
# Local: http://127.0.0.1:8000 | Docker: http://pdf-engine:8000
PDF_ENGINE_URL="http://127.0.0.1:8000"
PDF_ENGINE_API_KEY_HEADER="X-API-Key"
PDF_ENGINE_API_KEYS="local-dev-key"
# Key sent by this API to pdf-engine. Defaults to first PDF_ENGINE_API_KEYS value.
PDF_ENGINE_API_KEY="local-dev-key"

# =============================================================================
# QuickBooks Online Integration
# =============================================================================

# Register an app at https://developer.intuit.com and set these values.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# Must match the Redirect URI configured in the Intuit Developer Portal.
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/v1/integrations/quickbooks/callback"

# sandbox | production
QUICKBOOKS_ENVIRONMENT="sandbox"
QUICKBOOKS_MINOR_VERSION="75"

# AES-256-GCM key for encrypting tokens at rest.
# Generate with: openssl rand -hex 32
# Falls back to QUICKBOOKS_CLIENT_SECRET if omitted (not recommended for production).
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=""

# =============================================================================
# Microsoft Graph Mail
# =============================================================================

# Azure AD app registration credentials for sending emails.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# Comma-separated list of allowed sender email addresses.
MAIL_ALLOWED_SENDERS="sales@example.com,support@example.com"
MAIL_ALLOW_CUSTOM_SENDER="true"

# Paths relative to project root for mail assets and templates.
MAIL_ASSET_DIR="src/modules/mail/assets"
MAIL_TEMPLATE_DIR="src/modules/mail/templates"

# =============================================================================
# Fieldwire Integration
# =============================================================================

# API token for syncing Prime Change Orders from Fieldwire.
FIELDWIRE_API_TOKEN=""

# =============================================================================
# Seeder (development only)
# =============================================================================

# API key required to call seed endpoints. Leave empty to disable.
SEED_API_KEY=""
