# Build the Vite UI from the elli-ui subtree, then serve it from root nginx.
FROM oven/bun:1 AS ui-builder

WORKDIR /app

ARG VITE_API_BASE_URL=""
ARG VITE_ENABLE_MOCK_DATA_FILL="false"
ARG VITE_ENABLE_THEME_SWITCHER="false"
ARG VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=""
ARG VITE_PUBLIC_POSTHOG_HOST=""

COPY elli-ui/package.json elli-ui/bun.lock ./
RUN bun install

COPY elli-ui/ ./
RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" \
    VITE_ENABLE_MOCK_DATA_FILL="$VITE_ENABLE_MOCK_DATA_FILL" \
    VITE_ENABLE_THEME_SWITCHER="$VITE_ENABLE_THEME_SWITCHER" \
    VITE_PUBLIC_POSTHOG_PROJECT_TOKEN="$VITE_PUBLIC_POSTHOG_PROJECT_TOKEN" \
    VITE_PUBLIC_POSTHOG_HOST="$VITE_PUBLIC_POSTHOG_HOST" \
    bun run build:ng

FROM nginx:alpine

RUN apk add --no-cache logrotate

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/logrotate.conf /etc/logrotate.d/nginx
COPY nginx/docker-entrypoint.sh /usr/local/bin/z-nginx-entrypoint.sh
COPY --from=ui-builder /app/dist /usr/share/nginx/html

RUN rm -f /var/log/nginx/access.log /var/log/nginx/error.log \
    && touch /var/log/nginx/access.log /var/log/nginx/error.log \
    && chown nginx:nginx /var/log/nginx/access.log /var/log/nginx/error.log \
    && chmod +x /usr/local/bin/z-nginx-entrypoint.sh

EXPOSE 80

CMD ["z-nginx-entrypoint.sh"]
