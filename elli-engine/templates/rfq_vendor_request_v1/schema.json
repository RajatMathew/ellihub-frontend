{
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "rfq", "project", "vendor", "request", "deliverables", "deliverables_count", "footer"],
  "properties": {
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address_lines", "phone", "logo_path"],
      "properties": {
        "name": {
          "type": "string"
        },
        "address_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phone": {
          "type": "string"
        },
        "logo_path": {
          "type": "string"
        }
      }
    },
    "rfq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "description", "issued_on", "rfq_date", "type", "status"],
      "properties": {
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "issued_on": {
          "type": "string"
        },
        "rfq_date": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "number", "contract_number"],
      "properties": {
        "name": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "contract_number": {
          "type": "string"
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "email", "phone"],
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ship_to", "requested_by"],
      "properties": {
        "ship_to": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "description", "quantity", "unit"],
        "properties": {
          "sequence": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "deliverables_count": {
      "type": "string"
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "html"],
      "properties": {
        "included": { "type": "boolean" },
        "html": { "type": "string" }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "title", "html"],
      "properties": {
        "included": { "type": "boolean" },
        "title": { "type": "string" },
        "html": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left"],
      "properties": {
        "left": {
          "type": "string"
        }
      }
    }
  }
}
