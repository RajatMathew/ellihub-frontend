# =============================================================================
# Application (API) — required at runtime
# =============================================================================

# PostgreSQL connection string (used by Prisma and app).
# When running in Docker with compose: use service name "db" as host.
DATABASE_URL="postgresql://postgres:password@localhost:13333/ellinew?schema=public"

# Public URL of this API (used by better-auth callbacks, links).
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Allowed frontend origin (CORS, better-auth trustedOrigins).
CLIENT_URL="http://localhost:5173"

# Node environment: development | production
NODE_ENV="production"

# Port the API listens on inside the container (default 3000).
PORT="3000"

# =============================================================================
# Docker Compose / Dokploy — used by docker-compose.yml only
# Set these in Dokploy project/env vars or in .env when running compose.
# =============================================================================

# Postgres (db service)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="postgres"
POSTGRES_PORT="5432"
# API (api service) — host port mapped to container PORT
API_PORT="3000"

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=


