# =============================================================================
# Elli Core Environment
# =============================================================================
# Copy this file to .env and replace placeholders before running the app.
# Keep .env private; it may contain credentials and API tokens.

# =============================================================================
# Application / Auth
# =============================================================================

# Node environment: development | production
NODE_ENV="development"

# Port the API listens on inside the container (default 9000).
PORT="9000"

# Public frontend URL allowed by CORS and better-auth trusted origins.
CLIENT_URL="http://localhost:5173"

# Public API URL used by better-auth callbacks and generated links.
BETTER_AUTH_BASE_URL="http://localhost:9000"

# Generate a strong secret for local/staging/production environments.
BETTER_AUTH_SECRET="CHANGE_ME"

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string used by Prisma and the app.
# Local: use localhost. Docker compose: use the db service hostname.
DATABASE_URL="postgresql://postgres:password@localhost:5432/elli?schema=public"

# =============================================================================
# Docker Compose / Dokploy — used by docker-compose.yml only
# Set these in Dokploy project/env vars or in .env when running compose.
# =============================================================================

# Postgres (db service)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="elli"
POSTGRES_PORT="5432"

# Host port mapped to the API container when compose ports are enabled.
API_PORT="3000"

# =============================================================================
# Storage
# =============================================================================

STORAGE_PROVIDER="azure"
FILE_UPLOAD_MAX_BYTES="52428800"
FILE_UPLOAD_CHUNK_BYTES="8388608"

# Azure Blob SAS provider.
# BLOB_SAS_URL should be the container URL. If it already includes the SAS query,
# BLOB_SAS_TOKEN can be left empty. BLOB_SAS_TOKEN can include or omit the leading "?".
# The SAS needs read, create, write, and delete permissions for full file manager support.
BLOB_SAS_URL=""
BLOB_SAS_TOKEN=""

# S3-compatible fallback provider.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""

# =============================================================================
# PDF Engine
# =============================================================================

# Local: http://127.0.0.1:8000
# Docker network: http://pdf-engine:8000
PDF_ENGINE_API_KEY_HEADER="X-API-Key"
PDF_ENGINE_URL="http://127.0.0.1:8000"

# Comma-separated API keys. Any one of these values is accepted in the X-API-Key header.
PDF_ENGINE_API_KEYS=change-me-primary,change-me-secondary


# =============================================================================
# Fieldwire
# =============================================================================

FIELDWIRE_API_TOKEN=""

# =============================================================================
# Microsoft Graph Mail
# =============================================================================

MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

MAIL_ALLOWED_SENDERS="sales@ellicorp.com,bidding@ellicorp.com,procurement@ellicorp.com"
MAIL_ASSET_DIR="src/modules/mail/assets"
MAIL_TEMPLATE_DIR="src/modules/mail/templates"
ALLOW_EMAIL_SENDING="true"

# =============================================================================
# QuickBooks
# =============================================================================

QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
# sandbox | production
QUICKBOOKS_ENVIRONMENT="sandbox"
QUICKBOOKS_MINOR_VERSION="75"
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=""
QUICKBOOKS_REDIRECT_URI="http://localhost:9000/api/v1/integrations/quickbooks/callback"


# ═══════════════════════════════════════════════
# Agent / AI LLM
# ═══════════════════════════════════════════════
AGENT_LLM_PROVIDER="mistral"   # google | mistral | glm | openai
AGENT_KEY_ENCRYPTION_KEY=""    # AES-256-GCM; falls back to BETTER_AUTH_SECRET
GOOGLE_GENERATIVE_AI_API_KEY=""
MISTRAL_API_KEY=""
GLM_API_KEY=""

# Key used to encrypt the short-lived agent pairing key at rest (AES-256-GCM).
# Optional: falls back to BETTER_AUTH_SECRET when unset. Set a dedicated value
# in production so pairing-key encryption is independent of the auth secret.
AGENT_KEY_ENCRYPTION_KEY=""

ALLOW_EMAIL_SENDING="true"

# =============================================================================
# Notion Feedback Board
# =============================================================================

NOTION_ACCESS_TOKEN=""
NOTION_FEEDBACK_DATABASE_ID=""


# ═══════════════════════════════════════════════
# Aurinko Keys
# ═══════════════════════════════════════════════

AURINKO_CLIENT_ID=
AURINKO_CLIENT_SECRET=
AURINKO_SIGNING_SECRET=
AURINKO_REDIRECT_URI=http://localhost:9000/api/v1/email/auth/callback
AURINKO_BASE_URL=https://api.aurinko.io
PUBLIC_API_URL=http://localhost:9000