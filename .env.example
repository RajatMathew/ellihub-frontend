VITE_API_BASE_URL = ''
VITE_ENABLE_MOCK_DATA_FILL = 'true'
VITE_ENABLE_THEME_SWITCHER = 'false'
VITE_DISABLE_ELLIOT_AGENT = 'false'
# Hides Elliot the classifier's readings in the mailbox. The API's ELLIOT_EMAIL_READING stops the classifier itself.
