# Received-mail renderer. Default (unset, empty, 'macro' or anything else): Macro's renderer (shadow DOM, theme colours).
# Only 'iframe' switches back to the sandboxed iframe.
VITE_EMAIL_RENDERER = 'macro'
# TEMP_RECURRING_BILLS_QA_CLOCK: local sandbox QA only; remove after recurring-bills testing.
VITE_ENABLE_RECURRING_BILLS_QA_CLOCK = 'false'
VITE_SENTRY_DSN = ''
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN = ''
VITE_PUBLIC_POSTHOG_HOST = ''
