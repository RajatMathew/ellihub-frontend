# =============================================================================
# z-nginx service / elli-ui
# =============================================================================

# Combined stack default: keep empty so the browser uses same-origin /api/v1.
VITE_API_BASE_URL=

# =============================================================================
# z-db service / PostgreSQL
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# =============================================================================
# z-api service / elli-core
# =============================================================================

# Core runtime
DATABASE_URL=postgresql://postgres:CHANGE_ME@z-db:5432/postgres?schema=public
BETTER_AUTH_BASE_URL=http://localhost
CLIENT_URL=http://localhost
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
NODE_ENV=production
PORT=3000

# File storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# PDF engine client
PDF_ENGINE_URL=http://z-pdf:8000
PDF_ENGINE_API_KEY_HEADER=X-API-Key
PDF_ENGINE_API_KEY=CHANGE_ME_PDF_ENGINE_KEY

# QuickBooks Online
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost/api/v1/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MINOR_VERSION=75
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=

# Microsoft Graph Mail
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ALLOWED_SENDERS=
MAIL_ALLOWED_SENDERS=sales@ellicorp.com,bidding@ellicorp.com,procurement@ellicorp.com
MAIL_ALLOW_CUSTOM_SENDER=false
MAIL_ASSET_DIR=src/modules/mail/assets
MAIL_TEMPLATE_DIR=src/modules/mail/templates

# Fieldwire
FIELDWIRE_API_TOKEN=

# Seeder endpoints
SEED_API_KEY=

# =============================================================================
# z-db-backup service / PostgreSQL backups
# =============================================================================

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Optional cloud upload target. Leave empty for local backups only.
# Examples:
#   S3: backup:my-bucket/elli/postgres
#   Azure Blob: backup:my-container/elli/postgres
BACKUP_CLOUD_REMOTE=

# Optional rclone S3 remote named "backup".
RCLONE_CONFIG_BACKUP_TYPE=
RCLONE_CONFIG_BACKUP_PROVIDER=
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_REGION=
RCLONE_CONFIG_BACKUP_ENDPOINT=

# Optional rclone Azure Blob remote named "backup".
RCLONE_CONFIG_BACKUP_ACCOUNT=
RCLONE_CONFIG_BACKUP_KEY=

# =============================================================================
# z-pdf service / elli-engine
# =============================================================================

# Runtime
PYTHONUNBUFFERED=1

# API key accepted by z-pdf. Keep this aligned with z-api PDF_ENGINE_API_KEY.
PDF_ENGINE_API_KEYS=CHANGE_ME_PDF_ENGINE_KEY
PDF_ENGINE_API_KEY_HEADER=X-API-Key

# Network policy
PDF_ENGINE_ALLOWED_HOSTS=z-pdf,localhost,127.0.0.1
PDF_ENGINE_CORS_ALLOW_ORIGINS=http://localhost
PDF_ENGINE_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
PDF_ENGINE_CORS_ALLOW_HEADERS=Content-Type,Authorization,X-API-Key

# Storage paths
PDF_ENGINE_TEMPLATES_DIR=/app/templates
PDF_ENGINE_STORAGE_DIR=/app/storage
PDF_ENGINE_CACHE_DIR=/app/storage/cache
PDF_ENGINE_GENERATED_DIR=/app/storage/generated
PDF_ENGINE_BATCH_DIR=/app/storage/batch
PDF_ENGINE_PREVIEWS_DIR=/app/storage/previews
PDF_ENGINE_TEMP_DIR=/app/storage/temp

# Runtime limits
PDF_ENGINE_RENDER_TIMEOUT_SECONDS=10.0
PDF_ENGINE_MAX_PAYLOAD_BYTES=250000
PDF_ENGINE_MAX_BATCH_ITEMS=25
PDF_ENGINE_BATCH_CHUNK_SIZE=100
