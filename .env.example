PYTHONUNBUFFERED=1

# Comma-separated API keys. Any one of these values is accepted in the X-API-Key header.
PDF_ENGINE_API_KEYS=change-me-primary,change-me-secondary
PDF_ENGINE_API_KEY_HEADER=X-API-Key

# Dokploy/reverse-proxy friendly defaults. Use comma-separated domains to restrict access.
PDF_ENGINE_ALLOWED_HOSTS=*
PDF_ENGINE_CORS_ALLOW_ORIGINS=*
PDF_ENGINE_CORS_ALLOW_METHODS=*
PDF_ENGINE_CORS_ALLOW_HEADERS=*

# Persistent runtime directories inside the container.
PDF_ENGINE_STORAGE_DIR=/app/storage
PDF_ENGINE_CACHE_DIR=/app/storage/cache
PDF_ENGINE_GENERATED_DIR=/app/storage/generated
PDF_ENGINE_BATCH_DIR=/app/storage/batch
PDF_ENGINE_PREVIEWS_DIR=/app/storage/previews
PDF_ENGINE_TEMP_DIR=/app/storage/temp

# Runtime limits.
PDF_ENGINE_RENDER_TIMEOUT_SECONDS=10.0
PDF_ENGINE_MAX_PAYLOAD_BYTES=250000
PDF_ENGINE_MAX_BATCH_ITEMS=25
PDF_ENGINE_BATCH_CHUNK_SIZE=100
