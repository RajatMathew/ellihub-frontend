{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "purchase_order",
    "project",
    "vendor",
    "ship_to",
    "request",
    "line_items",
    "line_items_count",
    "summary",
    "terms",
    "footer"
  ],
  "properties": {
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address_lines", "phone", "logo_path"],
      "properties": {
        "name": { "type": "string" },
        "address_lines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phone": { "type": "string" },
        "logo_path": { "type": "string" }
      }
    },
    "purchase_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "description",
        "status",
        "issued_on",
        "expected_date",
        "trade_category",
        "lead_time",
        "payment_terms"
      ],
      "properties": {
        "number": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "issued_on": { "type": "string" },
        "expected_date": { "type": "string" },
        "trade_category": { "type": "string" },
        "lead_time": { "type": "string" },
        "payment_terms": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "number", "contract_number"],
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "string" },
        "contract_number": { "type": "string" }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "email", "phone"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "ship_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_by"],
      "properties": {
        "requested_by": { "type": "string" }
      }
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_number", "description", "quantity", "unit", "unit_price", "amount", "notes"],
        "properties": {
          "line_number": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "string" },
          "unit": { "type": "string" },
          "unit_price": { "type": "string" },
          "amount": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "line_items_count": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtotal",
        "negotiated_discount",
        "shipping_and_handling_fee",
        "tax_label",
        "tax_amount",
        "total",
        "retainage_percent",
        "retainage_amount"
      ],
      "properties": {
        "subtotal": { "type": "string" },
        "negotiated_discount": { "type": "string" },
        "shipping_and_handling_fee": { "type": "string" },
        "tax_label": { "type": "string" },
        "tax_amount": { "type": "string" },
        "total": { "type": "string" },
        "retainage_percent": { "type": "string" },
        "retainage_amount": { "type": "string" }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "html"],
      "properties": {
        "included": { "type": "boolean" },
        "html": { "type": "string" }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "title", "html"],
      "properties": {
        "included": { "type": "boolean" },
        "title": { "type": "string" },
        "html": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left"],
      "properties": {
        "left": { "type": "string" }
      }
    }
  }
}
