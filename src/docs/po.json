{
    "paths": {
        "/pos": {
            "get": {
                "tags": ["Purchase Orders"],
                "summary": "List purchase orders",
                "operationId": "listPOs",
                "parameters": [
                    { "name": "projectId", "in": "query", "schema": { "type": "string" } },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "ISSUED", "PARTIALLY_PAID", "PAID", "CANCELLED"] } },
                    { "name": "tradeCategory", "in": "query", "schema": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION", "LABOR", "EQUIPMENT"] } },
                    { "name": "vendorId", "in": "query", "schema": { "type": "string" } },
                    { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
                    { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
                    { "name": "overdue", "in": "query", "schema": { "type": "string", "enum": ["true"] } },
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25 } },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "issueDate" } },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of purchase orders",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/POListItem" } }, "pagination": { "$ref": "#/components/schemas/PaginationInfo" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" }
                }
            },
            "post": {
                "tags": ["Purchase Orders"],
                "summary": "Create a purchase order with line items",
                "operationId": "createPO",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POCreateRequest" }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "PO created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "Project or vendor not found" }
                }
            }
        },
        "/pos/summary/project/{projectId}": {
            "get": {
                "tags": ["Purchase Orders"],
                "summary": "Get PO summary for a project",
                "operationId": "getProjectPOSummary",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "PO summary",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/POSummary" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "Project not found" }
                }
            }
        },
        "/pos/vendor/{vendorId}": {
            "get": {
                "tags": ["Purchase Orders"],
                "summary": "List POs by vendor",
                "operationId": "getVendorPOHistory",
                "parameters": [
                    { "name": "vendorId", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "ISSUED", "PARTIALLY_PAID", "PAID", "CANCELLED"] } },
                    { "name": "projectId", "in": "query", "schema": { "type": "string" } },
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25 } },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "issueDate" } },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated vendor PO history",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/POListItem" } }, "pagination": { "$ref": "#/components/schemas/PaginationInfo" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" }
                }
            }
        },
        "/pos/{id}/issue": {
            "post": {
                "tags": ["Purchase Orders"],
                "summary": "Issue a purchase order",
                "operationId": "issuePO",
                "description": "Transitions PO from DRAFT to ISSUED. Auto-generates poNumber if not already set.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POIssueRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PO issued",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Only DRAFT POs can be issued" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        },
        "/pos/{id}/cancel": {
            "post": {
                "tags": ["Purchase Orders"],
                "summary": "Cancel a purchase order",
                "operationId": "cancelPO",
                "description": "Cancels the PO. Requires confirmation flags if PO has invoices or SCOs.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POCancelRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PO cancelled",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error or missing confirmations" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        },
        "/pos/{id}/record-delivery": {
            "post": {
                "tags": ["Purchase Orders"],
                "summary": "Record delivery for a PO",
                "operationId": "recordDelivery",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/PORecordDeliveryRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Delivery recorded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        },
        "/pos/{id}/line-items": {
            "post": {
                "tags": ["Purchase Orders"],
                "summary": "Add a line item to a PO",
                "operationId": "addPOLineItem",
                "description": "Adds a line item and recalculates PO financial totals.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POLineItemCreateRequest" }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Line item added",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/POLineItem" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error or PO not in DRAFT" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        },
        "/pos/{id}/line-items/{lineItemId}": {
            "put": {
                "tags": ["Purchase Orders"],
                "summary": "Update a PO line item",
                "operationId": "updatePOLineItem",
                "description": "Partial update. Recalculates PO financial totals.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "lineItemId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POLineItemUpdateRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Line item updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/POLineItem" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO or line item not found" }
                }
            },
            "delete": {
                "tags": ["Purchase Orders"],
                "summary": "Remove a PO line item",
                "operationId": "removePOLineItem",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "lineItemId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "Line item removed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO or line item not found" }
                }
            }
        },
        "/pos/{id}/invoices": {
            "get": {
                "tags": ["Purchase Orders"],
                "summary": "List invoices for a PO",
                "operationId": "listPOInvoices",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "List of invoices linked to this PO",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "type": "array", "items": { "type": "object" } } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        },
        "/pos/{id}": {
            "get": {
                "tags": ["Purchase Orders"],
                "summary": "Get a purchase order by ID",
                "operationId": "getPO",
                "description": "Full PO detail including line items, attachments, linked SCOs, and invoices.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "PO detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            },
            "put": {
                "tags": ["Purchase Orders"],
                "summary": "Update a purchase order (DRAFT only)",
                "operationId": "updatePO",
                "description": "Partial update. Only DRAFT POs can be updated.",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/POUpdateRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PO updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Only DRAFT POs can be updated" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            },
            "delete": {
                "tags": ["Purchase Orders"],
                "summary": "Soft-delete a purchase order (DRAFT only)",
                "operationId": "deletePO",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "PO deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "400": { "description": "Only DRAFT POs can be deleted" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PO not found" }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "POListItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "poNumber": { "type": "string", "example": "PO-2026-001-001" },
                    "description": { "type": "string" },
                    "tradeCategory": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION", "LABOR", "EQUIPMENT"] },
                    "total": { "type": "number" },
                    "totalCommitment": { "type": "number", "description": "Total + approved SCOs" },
                    "status": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "label": { "type": "string" }, "color": { "type": "string" } } },
                    "issueDate": { "type": "string", "format": "date-time" },
                    "expectedDate": { "type": "string", "format": "date-time", "nullable": true },
                    "deliveryDate": { "type": "string", "format": "date-time", "nullable": true },
                    "vendor": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
                    "project": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "jobNumber": { "type": "string" } } },
                    "isOverdue": { "type": "boolean" },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "PODetail": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "projectId": { "type": "string" },
                    "vendorId": { "type": "string" },
                    "rfqId": { "type": "string", "nullable": true },
                    "poNumber": { "type": "string" },
                    "description": { "type": "string" },
                    "tradeCategory": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION", "LABOR", "EQUIPMENT"] },
                    "status": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "label": { "type": "string" }, "color": { "type": "string" } } },
                    "contactName": { "type": "string", "nullable": true },
                    "contactEmail": { "type": "string", "nullable": true },
                    "contactPhone": { "type": "string", "nullable": true },
                    "leadTime": { "type": "string", "nullable": true },
                    "issueDate": { "type": "string", "format": "date-time" },
                    "expectedDate": { "type": "string", "format": "date-time", "nullable": true },
                    "deliveryDate": { "type": "string", "format": "date-time", "nullable": true },
                    "shipToAddress": { "type": "string", "nullable": true },
                    "subtotal": { "type": "number" },
                    "taxPercent": { "type": "number" },
                    "taxAmount": { "type": "number" },
                    "total": { "type": "number" },
                    "totalCommitment": { "type": "number" },
                    "retainagePercent": { "type": "number" },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "notes": { "type": "string", "nullable": true },
                    "vendorNotes": { "type": "string", "nullable": true },
                    "issuedBy": { "type": "string", "nullable": true },
                    "issuedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "cancelledBy": { "type": "string", "nullable": true },
                    "cancelledAt": { "type": "string", "format": "date-time", "nullable": true },
                    "cancellationReason": { "type": "string", "nullable": true },
                    "createdBy": { "type": "string" },
                    "isOverdue": { "type": "boolean" },
                    "project": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "jobNumber": { "type": "string" } } },
                    "vendor": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
                    "lineItems": { "type": "array", "items": { "$ref": "#/components/schemas/POLineItem" } },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "POLineItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "purchaseOrderId": { "type": "string" },
                    "lineNumber": { "type": "integer" },
                    "description": { "type": "string" },
                    "quantity": { "type": "number" },
                    "unit": { "type": "string" },
                    "unitPrice": { "type": "number" },
                    "amount": { "type": "number", "description": "Auto-computed: quantity x unitPrice" },
                    "costCodeId": { "type": "string", "nullable": true },
                    "notes": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "POSummary": {
                "type": "object",
                "properties": {
                    "totalCount": { "type": "integer" },
                    "totalCommitted": { "type": "number" },
                    "byStatus": { "type": "object" },
                    "byTradeCategory": { "type": "object" },
                    "overdueCount": { "type": "integer" }
                }
            },
            "POCreateRequest": {
                "type": "object",
                "required": ["projectId", "vendorId", "tradeCategory", "description", "issueDate", "paymentTerms", "lineItems"],
                "properties": {
                    "projectId": { "type": "string" },
                    "vendorId": { "type": "string" },
                    "rfqId": { "type": "string" },
                    "tradeCategory": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION", "LABOR", "EQUIPMENT"] },
                    "description": { "type": "string", "minLength": 1 },
                    "contactName": { "type": "string", "maxLength": 255 },
                    "contactEmail": { "type": "string", "format": "email" },
                    "contactPhone": { "type": "string", "maxLength": 50 },
                    "leadTime": { "type": "string" },
                    "issueDate": { "type": "string", "format": "date" },
                    "expectedDate": { "type": "string", "format": "date" },
                    "shipToAddress": { "type": "string" },
                    "taxPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "retainagePercent": { "type": "number", "minimum": 0, "maximum": 100 },
                    "notes": { "type": "string" },
                    "vendorNotes": { "type": "string" },
                    "lineItems": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/POLineItemCreateRequest" } }
                }
            },
            "POUpdateRequest": {
                "type": "object",
                "description": "All fields optional (partial update).",
                "properties": {
                    "description": { "type": "string", "minLength": 1 },
                    "contactName": { "type": "string", "maxLength": 255, "nullable": true },
                    "contactEmail": { "type": "string", "format": "email", "nullable": true },
                    "contactPhone": { "type": "string", "maxLength": 50, "nullable": true },
                    "leadTime": { "type": "string", "nullable": true },
                    "expectedDate": { "type": "string", "format": "date", "nullable": true },
                    "shipToAddress": { "type": "string", "nullable": true },
                    "taxPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "retainagePercent": { "type": "number", "minimum": 0, "maximum": 100 },
                    "notes": { "type": "string", "nullable": true },
                    "vendorNotes": { "type": "string", "nullable": true }
                }
            },
            "POIssueRequest": {
                "type": "object",
                "properties": {
                    "emailVendor": { "type": "boolean" }
                }
            },
            "POCancelRequest": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                    "reason": { "type": "string", "minLength": 20 },
                    "notifyVendor": { "type": "boolean" },
                    "confirmInvoices": { "type": "boolean" },
                    "confirmSCOs": { "type": "boolean" }
                }
            },
            "PORecordDeliveryRequest": {
                "type": "object",
                "required": ["deliveryDate"],
                "properties": {
                    "deliveryDate": { "type": "string", "format": "date" },
                    "notes": { "type": "string" }
                }
            },
            "POLineItemCreateRequest": {
                "type": "object",
                "required": ["description", "quantity", "unit", "unitPrice"],
                "properties": {
                    "description": { "type": "string", "minLength": 1 },
                    "quantity": { "type": "number", "exclusiveMinimum": 0 },
                    "unit": { "type": "string", "minLength": 1 },
                    "unitPrice": { "type": "number", "minimum": 0 },
                    "costCodeId": { "type": "string" },
                    "notes": { "type": "string" }
                }
            },
            "POLineItemUpdateRequest": {
                "type": "object",
                "description": "All fields optional. At least one required.",
                "properties": {
                    "description": { "type": "string", "minLength": 1 },
                    "quantity": { "type": "number", "exclusiveMinimum": 0 },
                    "unit": { "type": "string", "minLength": 1 },
