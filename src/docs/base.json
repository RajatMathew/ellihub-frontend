{
    "openapi": "3.0.3",
    "info": {
        "title": "Elli Core API",
        "description": "Core API for the Elli application",
        "version": "0.1.0",
        "contact": {
            "name": "Mohammed Yasim",
            "email": "yasim@azba.in"
        }
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "security": [
        {
            "cookieAuth": []
        }
    ],
    "paths": {},
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "better-auth.session_token",
                "description": "Session cookie set by Better-Auth after sign-in"
            }
        },
        "schemas": {
            "SuccessResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "OK" },
                    "path": { "type": "string", "example": "/api/v1/cost-code" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "timeElapsed": { "type": "string", "example": "12.34 ms" }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string" },
                    "details": { "type": "object", "nullable": true },
                    "path": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" }
                }
            },
            "PaginationInfo": {
                "type": "object",
                "properties": {
                    "currentPage": { "type": "integer", "example": 1 },
                    "totalPages": { "type": "integer", "example": 5 },
                    "hasNextPage": { "type": "boolean" },
                    "hasPreviousPage": { "type": "boolean" },
                    "totalItems": { "type": "integer", "example": 120 },
                    "itemsPerPage": { "type": "integer", "example": 25 }
                }
            }
        }
    },
    "tags": [
        { "name": "Auth", "description": "Authentication (Better-Auth)" },
        { "name": "Users", "description": "User management" },
        { "name": "Contacts", "description": "Contact management" },
        { "name": "Professional Roles", "description": "Manage professional roles for contacts" },
        { "name": "Vendors", "description": "Vendor management" },
        { "name": "Vendor Contacts", "description": "Manage vendor-contact links" },
        { "name": "General Contractors", "description": "General contractor management" },
        { "name": "GC Types", "description": "Manage general contractor types" },
        { "name": "Cost Code Categories", "description": "Manage cost code categories" },
        { "name": "Cost Codes", "description": "Manage cost codes" },
        { "name": "File", "description": "File and folder management (S3)" },
        { "name": "Project Statuses", "description": "Manage project status lookup values" },
        { "name": "Project Stages", "description": "Manage project stage lookup values" },
        { "name": "Purchase Orders", "description": "Purchase order lifecycle, line items, payments, and delivery tracking" },
        { "name": "RFQs", "description": "Request for Quotation management, vendor invitations, quotes, and bid comparison" },
        { "name": "Sub Change Orders", "description": "Subcontractor Change Order management, approval workflow, and margin comparison" },
        { "name": "Prime Change Orders", "description": "Prime Change Order (PCO) management and status transitions" },
        { "name": "Invoices", "description": "Invoice management, approval workflow, disputes, and aging reports" },
        { "name": "Employees", "description": "Employee management and project assignments" },
        { "name": "Change Order Statuses", "description": "Manage change order status lookup values (shared by PCO and SCO)" },
        { "name": "PCO Change Types", "description": "Manage PCO change type categories" },
        { "name": "SCO Change Types", "description": "Manage SCO change type categories" },
        { "name": "RFQ Statuses", "description": "Manage RFQ status lookup values" },
        { "name": "Quote Statuses", "description": "Manage quote status lookup values" },
        { "name": "PO Statuses", "description": "Manage purchase order status lookup values" },
        { "name": "Invoice Statuses", "description": "Manage invoice status lookup values" },
        { "name": "Addendum Change Types", "description": "Manage RFQ addendum change type categories" }
    ]
}
