{
    "paths": {
        "/pcos": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "List prime change orders for a project",
                "operationId": "listPCOs",
                "parameters": [
                    {
                        "name": "projectId",
                        "in": "query",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Project ID (required)"
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"] }
                    },
                    {
                        "name": "changeTypeId",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by PCO change type"
                    },
                    {
                        "name": "priority",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] }
                    },
                    {
                        "name": "dateFrom",
                        "in": "query",
                        "schema": { "type": "string", "format": "date" },
                        "description": "Filter PCOs from this date"
                    },
                    {
                        "name": "dateTo",
                        "in": "query",
                        "schema": { "type": "string", "format": "date" },
                        "description": "Filter PCOs up to this date"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Search title, description, or pcoNumber"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1 }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": { "type": "integer", "default": 25 }
                    },
                    {
                        "name": "sortBy",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["date", "pcoNumber", "amount", "status", "createdAt"], "default": "date" }
                    },
                    {
                        "name": "sortOrder",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of PCOs",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/PCOListItem" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Missing projectId query parameter" },
                    "401": { "description": "Unauthorized" }
                }
            },
            "post": {
                "tags": ["Prime Change Orders"],
                "summary": "Create a prime change order with line items",
                "operationId": "createPCO",
                "description": "Creates a new PCO in DRAFT status. The pcoNumber is auto-generated as `PCO-{jobNumber}-{seq}`. Margin fields are auto-computed from amount and estimatedCost.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/PCOCreateRequest" },
                            "examples": {
                                "scope-addition": {
                                    "summary": "Scope addition with schedule impact",
                                    "value": {
                                        "projectId": "01KJ7JDGN65DQ7X4HHX8QMSVPT",
                                        "date": "2026-02-24",
                                        "title": "Additional steel reinforcement",
                                        "description": "Extra rebar needed due to soil conditions",
                                        "amount": 15000,
                                        "estimatedCost": 12000,
                                        "impactsSchedule": true,
                                        "scheduleImpactDays": 5,
                                        "changeTypeId": "01KJ7T4GRRTHJJ1PNDKVTYG7RB",
                                        "priority": "HIGH",
                                        "lineItems": [
                                            {
                                                "title": "Rebar #5",
                                                "description": "Grade 60 rebar",
                                                "qty": 100,
                                                "unit": "LF",
                                                "unitPrice": 85
                                            },
                                            {
                                                "title": "Installation labor",
                                                "description": "Union labor for rebar installation",
                                                "qty": 40,
                                                "unit": "HR",
                                                "unitPrice": 100
                                            }
                                        ]
                                    }
                                },
                                "simple": {
                                    "summary": "Simple PCO without schedule impact",
                                    "value": {
                                        "projectId": "01KJ7JDGN65DQ7X4HHX8QMSVPT",
                                        "date": "2026-02-24",
                                        "title": "Electrical panel upgrade",
                                        "description": "Main panel needs 200A upgrade",
                                        "amount": 8500,
                                        "lineItems": [
                                            {
                                                "title": "200A Panel",
                                                "description": "Main electrical panel",
                                                "qty": 1,
                                                "unit": "EA",
                                                "unitPrice": 8500
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "PCO created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PCODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "Project, contact, change type, or cost code not found" }
                }
            }
        },
        "/pcos/{id}": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "Get a prime change order by ID",
                "operationId": "getPCO",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "PCO detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PCODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PCO not found" }
                }
            },
            "put": {
                "tags": ["Prime Change Orders"],
                "summary": "Update a prime change order (DRAFT only)",
                "operationId": "updatePCO",
                "description": "Partial update. Only DRAFT PCOs can be updated. Margin fields are auto-recomputed when amount or estimatedCost changes.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/PCOUpdateRequest" },
                            "examples": {
                                "update-amount": {
                                    "summary": "Revise amount and cost",
                                    "value": {
                                        "amount": 18000,
                                        "estimatedCost": 14000
                                    }
                                },
                                "update-details": {
                                    "summary": "Update title and priority",
                                    "value": {
                                        "title": "Revised steel reinforcement scope",
                                        "priority": "URGENT"
                                    }
                                },
                                "clear-optional": {
                                    "summary": "Clear optional fields",
                                    "value": {
                                        "markupAmount": null,
                                        "costCodeId": null,
                                        "changeTypeId": null
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PCO updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PCODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Only DRAFT change orders can be updated" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PCO not found" }
                }
            },
            "delete": {
                "tags": ["Prime Change Orders"],
                "summary": "Soft-delete a prime change order (DRAFT only)",
                "operationId": "deletePCO",
                "description": "Soft-deletes the PCO and all its line items. Only DRAFT PCOs can be deleted.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "PCO deleted",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "400": { "description": "Only DRAFT change orders can be deleted" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PCO not found" }
                }
            }
        },
        "/pcos/{id}/status": {
            "put": {
                "tags": ["Prime Change Orders"],
                "summary": "Transition PCO status",
                "operationId": "transitionPCOStatus",
                "description": "Valid transitions: DRAFT→APPROVED, DRAFT→REJECTED, APPROVED→VOID. On APPROVED: if impactsSchedule, a schedule entry is auto-created and project dates recalculated. On VOID: linked schedule entries are soft-deleted and project dates recalculated. Reason is required for REJECTED and VOID.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/PCOStatusTransitionRequest" },
                            "examples": {
                                "approve": {
                                    "summary": "Approve a DRAFT PCO",
                                    "value": {
                                        "status": "APPROVED"
                                    }
                                },
                                "reject": {
                                    "summary": "Reject a DRAFT PCO (reason required)",
                                    "value": {
                                        "status": "REJECTED",
                                        "reason": "Scope not justified per owner review"
                                    }
                                },
                                "void": {
                                    "summary": "Void an APPROVED PCO (reason required)",
                                    "value": {
                                        "status": "VOID",
                                        "reason": "Owner decided to reduce scope"
                                    }
                                },
                                "on-behalf-of": {
                                    "summary": "Approve on behalf of another user",
                                    "value": {
                                        "status": "APPROVED",
                                        "onBehalfOf": "EMPLOYEE_USER_ID"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status transitioned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "properties": { "data": { "$ref": "#/components/schemas/PCODetail" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Invalid transition or missing reason" },
                    "401": { "description": "Unauthorized" },
                    "404": { "description": "PCO not found" }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PCOListItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "pcoNumber": { "type": "string", "example": "PCO-2026-001-001" },
                    "date": { "type": "string", "format": "date-time" },
                    "title": { "type": "string" },
                    "amount": { "type": "number" },
                    "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"] },
                    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
                    "impactsSchedule": { "type": "boolean" },
                    "changeType": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "code": { "type": "string" },
                            "color": { "type": "string" }
                        }
                    },
                    "project": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "jobNumber": { "type": "string" }
                        }
                    },
                    "creator": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" }
                        }
                    },
                    "_count": {
                        "type": "object",
                        "properties": {
                            "lineItems": { "type": "integer" }
                        }
                    },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "PCODetail": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "projectId": { "type": "string" },
                    "pcoNumber": { "type": "string", "example": "PCO-2026-001-001" },
                    "date": { "type": "string", "format": "date-time" },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "amount": { "type": "number" },
                    "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"] },
                    "revisionNumber": { "type": "integer" },
                    "createdBy": { "type": "string" },
                    "markupAmount": { "type": "number", "nullable": true },
                    "scheduleImpactDays": { "type": "integer", "nullable": true },
                    "requestedBy": { "type": "string", "nullable": true },
                    "estimatedCost": { "type": "number", "nullable": true },
                    "estimatedMargin": { "type": "number", "nullable": true, "description": "Auto-computed: amount - estimatedCost" },
                    "estimatedMarginPercent": { "type": "number", "nullable": true, "description": "Auto-computed: (margin / amount) * 100" },
                    "changeTypeId": { "type": "string", "nullable": true },
                    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
                    "impactsSchedule": { "type": "boolean" },
                    "costCodeId": { "type": "string", "nullable": true },
                    "contactId": { "type": "string", "nullable": true },
                    "supersededBy": { "type": "string", "nullable": true },
                    "deletedAt": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "project": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "jobNumber": { "type": "string" }
                        }
                    },
                    "creator": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "email": { "type": "string" }
                        }
                    },
                    "contact": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": { "type": "string" },
                            "fullName": { "type": "string" }
                        }
                    },
                    "changeType": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "code": { "type": "string" },
                            "color": { "type": "string" }
                        }
                    },
                    "costCode": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "code": { "type": "string" }
                        }
                    },
                    "lineItems": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/PCOLineItem" }
                    },
                    "attachments": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/PCOAttachment" }
                    },
                    "statusHistory": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/PCOStatusHistoryEntry" }
                    },
                    "supersededByOrder": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "id": { "type": "string" },
                            "pcoNumber": { "type": "string" }
                        }
                    }
                }
            },
            "PCOLineItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "primeCoId": { "type": "string" },
                    "sequenceNumber": { "type": "integer" },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "qty": { "type": "number" },
                    "unit": { "type": "string" },
                    "unitPrice": { "type": "number" },
                    "amount": { "type": "number", "description": "Auto-computed: qty × unitPrice" },
                    "costCodeId": { "type": "string", "nullable": true },
                    "deletedAt": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "PCOAttachment": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "pcoId": { "type": "string" },
                    "document": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" }
                        }
                    },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "PCOStatusHistoryEntry": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "pcoId": { "type": "string" },
                    "fromStatus": { "type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"], "nullable": true },
                    "toStatus": { "type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"] },
                    "changedBy": { "type": "string" },
                    "onBehalfOf": { "type": "string", "nullable": true },
                    "reason": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "PCOCreateRequest": {
                "type": "object",
                "required": ["projectId", "date", "title", "description", "amount", "lineItems"],
                "properties": {
                    "projectId": { "type": "string" },
                    "date": { "type": "string", "format": "date-time", "description": "Date of the change order" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "description": { "type": "string", "minLength": 1 },
                    "amount": { "type": "number", "description": "Total CO amount" },
                    "markupAmount": { "type": "number" },
                    "scheduleImpactDays": { "type": "integer", "description": "Days added to schedule (used when impactsSchedule is true)" },
                    "requestedBy": { "type": "string", "maxLength": 255 },
                    "contactId": { "type": "string", "description": "GC contact this CO was sent to (Contact ID)" },
                    "changeTypeId": { "type": "string", "description": "PCOChangeType ID" },
                    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
                    "impactsSchedule": { "type": "boolean", "description": "When true and status transitions to APPROVED, a schedule entry is auto-created" },
                    "estimatedCost": { "type": "number", "description": "Used to auto-compute estimatedMargin and estimatedMarginPercent" },
                    "costCodeId": { "type": "string", "description": "CostCode ID" },
                    "lineItems": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/components/schemas/PCOLineItemCreateRequest" }
                    }
                }
            },
            "PCOLineItemCreateRequest": {
                "type": "object",
                "required": ["title", "description", "qty", "unit", "unitPrice"],
                "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "description": { "type": "string", "minLength": 1 },
                    "qty": { "type": "number", "exclusiveMinimum": 0 },
                    "unit": { "type": "string", "minLength": 1, "description": "e.g. LF, SF, EA, HR" },
                    "unitPrice": { "type": "number" },
                    "costCodeId": { "type": "string" }
                }
            },
            "PCOUpdateRequest": {
                "type": "object",
                "description": "All fields optional (partial update). At least one field required. Set nullable fields to null to clear them.",
                "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "description": { "type": "string", "minLength": 1 },
                    "amount": { "type": "number" },
                    "markupAmount": { "type": "number", "nullable": true },
                    "scheduleImpactDays": { "type": "integer", "nullable": true },
                    "requestedBy": { "type": "string", "maxLength": 255, "nullable": true },
                    "contactId": { "type": "string", "nullable": true },
                    "changeTypeId": { "type": "string", "nullable": true },
                    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
                    "impactsSchedule": { "type": "boolean" },
                    "estimatedCost": { "type": "number", "nullable": true },
                    "costCodeId": { "type": "string", "nullable": true }
                }
            },
            "PCOStatusTransitionRequest": {
                "type": "object",
                "required": ["status"],
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": ["DRAFT", "APPROVED", "REJECTED", "VOID"],
                        "description": "Target status. Valid: DRAFT→APPROVED, DRAFT→REJECTED, APPROVED→VOID"
                    },
                    "reason": {
                        "type": "string",
                        "maxLength": 2000,
                        "description": "Required for REJECTED and VOID transitions"
                    },
                    "onBehalfOf": {
                        "type": "string",
                        "description": "User ID if acting on behalf of someone else"
                    }
                }
            }
        }
    }
}
