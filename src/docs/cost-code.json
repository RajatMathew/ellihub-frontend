    "components": {
        "schemas": {
            "CostCodeCategory": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID", "example": "01HYX..." },
                    "name": { "type": "string", "example": "General Conditions" },
                    "description": { "type": "string", "nullable": true },
                    "tenantId": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
                }
            },
            "CostCodeCategoryCreateRequest": {
                "type": "object",
                "required": ["name"],
                "properties": {
                    "name": { "type": "string", "minLength": 2, "example": "General Conditions" },
                    "description": { "type": "string", "nullable": true }
                }
            },
            "CostCodeCategoryUpdateRequest": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "minLength": 2 },
                    "description": { "type": "string", "nullable": true }
                }
            },
            "CostCode": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID", "example": "01HYX..." },
                    "name": { "type": "string", "example": "Site Work" },
                    "code": { "type": "string", "example": "01-100" },
                    "description": { "type": "string" },
                    "costCodeCategoryId": { "type": "string", "description": "ULID of the parent category" },
                    "tenantId": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
                }
            },
            "CostCodeCreateRequest": {
                "type": "object",
                "required": ["name", "code", "costCodeCategoryId", "description"],
                "properties": {
                    "name": { "type": "string", "minLength": 2, "example": "Site Work" },
                    "code": { "type": "string", "minLength": 2, "example": "01-100" },
                    "costCodeCategoryId": { "type": "string", "description": "ULID of the parent category" },
                    "description": { "type": "string", "minLength": 1 }
                }
            },
            "CostCodeUpdateRequest": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "minLength": 2 },
                    "code": { "type": "string", "minLength": 2 },
                    "costCodeCategoryId": { "type": "string", "description": "ULID of the parent category" },
                    "description": { "type": "string", "minLength": 1 }
                }
            }
        }
    }
}
