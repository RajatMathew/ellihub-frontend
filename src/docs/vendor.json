{
    "paths": {
        "/vendors": {
            "post": {
                "tags": ["Vendors"],
                "summary": "Create a vendor",
                "operationId": "createVendor",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/VendorCreateRequest" },
                            "example": {
                                "name": "Acme Steel Supply",
                                "type": "MATERIAL",
                                "categoryTags": ["steel", "structural"],
                                "taxId": "12-3456789",
                                "status": "ACTIVE",
                                "address": "100 Industrial Blvd, Houston TX 77001",
                                "email": "info@acmesteel.com",
                                "phone": "+1-555-0001",
                                "website": "https://acmesteel.com",
                                "paymentTerms": "NET_30",
                                "notes": "Preferred steel supplier",
                                "contacts": []
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Vendor created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Vendor" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "get": {
                "tags": ["Vendors"],
                "summary": "List vendors (paginated)",
                "operationId": "getVendors",
                "parameters": [
                    { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by name, email, or phone" },
                    { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION"] }, "description": "Filter by vendor type" },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLACKLISTED", "PROSPECT"] }, "description": "Filter by status" },
                    { "name": "categoryTag", "in": "query", "schema": { "type": "string" }, "description": "Filter by category tag" },
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25 } },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["name", "type", "status", "createdAt", "updatedAt"], "default": "name" } },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of vendors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/VendorListItem" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendors/{id}": {
            "get": {
                "tags": ["Vendors"],
                "summary": "Get a vendor by ID",
                "operationId": "getVendor",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Vendor details with contact links",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Vendor" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Vendor not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "put": {
                "tags": ["Vendors"],
                "summary": "Update a vendor",
                "operationId": "updateVendor",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/VendorUpdateRequest" },
                            "example": {
                                "name": "Acme Steel Supply LLC",
                                "paymentTerms": "NET_45",
                                "notes": "Updated terms after contract renewal"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Vendor updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Vendor" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Vendor not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["Vendors"],
                "summary": "Delete a vendor (sets status to INACTIVE)",
                "operationId": "deleteVendor",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Vendor deactivated",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Vendor not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendors/{id}/contacts": {
            "post": {
                "tags": ["Vendor Contacts"],
                "summary": "Add a contact to a vendor",
                "operationId": "addVendorContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Vendor ID" }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/VendorContactAddRequest" },
                            "example": {
                                "contactId": "01JMSEEDCONTACT000001",
                                "isPrimary": true
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contact linked to vendor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/ContactVendorLink" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Vendor or contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "Contact already linked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendors/{id}/contacts/{contactId}": {
            "put": {
                "tags": ["Vendor Contacts"],
                "summary": "Update a contact link (isPrimary)",
                "operationId": "updateVendorContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Vendor ID" },
                    { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Contact ID" }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/VendorContactUpdateRequest" },
                            "example": { "isPrimary": true }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contact link updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/ContactVendorLink" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Contact link not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["Vendor Contacts"],
                "summary": "Remove a contact from a vendor",
                "operationId": "removeVendorContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Vendor ID" },
                    { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Contact ID" }
                ],
                "responses": {
                    "200": {
                        "description": "Contact unlinked from vendor",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "404": { "description": "Contact link not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "VendorCreateRequest": {
                "type": "object",
                "required": ["name", "type"],
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION"] },
                    "categoryTags": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "taxId": { "type": "string" },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLACKLISTED", "PROSPECT"], "default": "ACTIVE" },
                    "address": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "phone": { "type": "string" },
                    "website": { "type": "string" },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"], "default": "NET_30" },
                    "notes": { "type": "string" },
                    "contacts": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["contactId"],
                            "properties": {
                                "contactId": { "type": "string" },
                                "isPrimary": { "type": "boolean", "default": false }
                            }
                        },
                        "default": []
                    }
                }
            },
            "VendorUpdateRequest": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION"] },
                    "categoryTags": { "type": "array", "items": { "type": "string" } },
                    "taxId": { "type": "string", "nullable": true },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLACKLISTED", "PROSPECT"] },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "notes": { "type": "string", "nullable": true }
                }
            },
            "VendorContactAddRequest": {
                "type": "object",
                "required": ["contactId"],
                "properties": {
                    "contactId": { "type": "string" },
                    "isPrimary": { "type": "boolean", "default": false }
                }
            },
            "VendorContactUpdateRequest": {
                "type": "object",
                "required": ["isPrimary"],
                "properties": {
                    "isPrimary": { "type": "boolean" }
                }
            },
            "Vendor": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["MATERIAL", "FABRICATION", "INSTALLATION"] },
                    "categoryTags": { "type": "array", "items": { "type": "string" } },
                    "taxId": { "type": "string", "nullable": true },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLACKLISTED", "PROSPECT"] },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "notes": { "type": "string", "nullable": true },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "contactLinks": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ContactVendorLink" }
                    }
                }
            },
            "VendorListItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "categoryTags": { "type": "array", "items": { "type": "string" } },
                    "taxId": { "type": "string", "nullable": true },
                    "status": { "type": "string" },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string" },
                    "notes": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "_count": {
                        "type": "object",
                        "properties": {
                            "contactLinks": { "type": "integer" }
                        }
                    }
                }
            },
            "ContactVendorLink": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "contactId": { "type": "string" },
                    "vendorId": { "type": "string" },
                    "isPrimary": { "type": "boolean" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "contact": { "$ref": "#/components/schemas/ContactSummary" }
                }
            },
            "ContactSummary": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "fullName": { "type": "string" },
                    "email": { "type": "object", "nullable": true },
                    "phoneNumber": { "type": "object", "nullable": true },
                    "tags": { "type": "array", "items": { "type": "string" } }
                }
            }
        }
    }
}
