{
    "paths": {
        "/vendor": {
            "get": {
                "tags": ["Vendors"],
                "summary": "List vendors (paginated)",
                "operationId": "listVendors",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25, "maximum": 100 } },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" } },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } },
                    { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by vendor name" },
                    { "name": "typeId", "in": "query", "schema": { "type": "string" }, "description": "Filter by vendor type lookup ULID" },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] } }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of vendors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Vendor" } },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires vendor:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "post": {
                "tags": ["Vendors"],
                "summary": "Create a vendor",
                "operationId": "createVendor",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorCreateRequest" } } }
                },
                "responses": {
                    "201": {
                        "description": "Vendor created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Vendor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires vendor:create)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Vendor type or linked contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "put": {
                "tags": ["Vendors"],
                "summary": "Update a vendor (full replace)",
                "operationId": "updateVendor",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorUpdateRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Vendor updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Vendor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires vendor:update)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Vendor or linked entity not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendor/{id}": {
            "get": {
                "tags": ["Vendors"],
                "summary": "Get a vendor by ID",
                "operationId": "getVendor",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Vendor ULID" }
                ],
                "responses": {
                    "200": {
                        "description": "Vendor details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Vendor" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Vendor not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["Vendors"],
                "summary": "Delete a vendor (soft delete)",
                "operationId": "deleteVendor",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Vendor ULID" }
                ],
                "responses": {
                    "200": { "description": "Vendor deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "Vendor not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendor/document/add": {
            "patch": {
                "tags": ["Vendors"],
                "summary": "Link a document (file) to a vendor",
                "operationId": "addDocumentToVendor",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddVendorDocumentRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Document linked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/VendorDocument" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Vendor or file not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "Document already linked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendor/document/update": {
            "patch": {
                "tags": ["Vendors"],
                "summary": "Update a vendor document (e.g. expiry)",
                "operationId": "updateVendorDocument",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateVendorDocumentRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "Document updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/VendorDocument" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Vendor document not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/vendor/document/remove": {
            "patch": {
                "tags": ["Vendors"],
                "summary": "Unlink a document from a vendor",
                "operationId": "removeDocumentFromVendor",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemoveVendorDocumentRequest" } } }
                },
                "responses": {
                    "200": { "description": "Document unlinked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "Vendor document not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "VendorContact": {
                "type": "object",
                "required": ["contactId"],
                "properties": {
                    "contactId": { "type": "string", "description": "Contact ULID" },
                    "isPrimary": { "type": "boolean", "default": false }
                }
            },
            "Vendor": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "name": { "type": "string" },
                    "typeId": { "type": "string", "nullable": true },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
                    "categoryTags": { "type": "array", "items": { "type": "string" } },
                    "taxId": { "type": "string", "nullable": true },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "format": "uri", "nullable": true },
                    "fax": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "notes": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
                }
            },
            "VendorDocument": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "vendorId": { "type": "string" },
                    "fileId": { "type": "string" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "VendorCreateRequest": {
                "type": "object",
                "required": ["name", "status"],
                "properties": {
                    "name": { "type": "string", "minLength": 2 },
                    "typeId": { "type": "string", "nullable": true, "description": "Vendor type lookup ULID" },
                    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
                    "categoryTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "taxId": { "type": "string", "nullable": true },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "format": "uri", "nullable": true },
                    "fax": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"], "default": "NET_30" },
                    "notes": { "type": "string", "nullable": true },
                    "contacts": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/VendorContact" } }
                }
            },
            "VendorUpdateRequest": {
                "allOf": [
                    { "$ref": "#/components/schemas/VendorCreateRequest" },
                    {
                        "type": "object",
                        "required": ["id"],
                        "properties": { "id": { "type": "string", "description": "Vendor ULID" } }
                    }
                ]
            },
            "AddVendorDocumentRequest": {
                "type": "object",
                "required": ["vendorId", "fileId"],
                "properties": {
                    "vendorId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true }
                }
            },
            "UpdateVendorDocumentRequest": {
                "type": "object",
                "required": ["vendorId", "fileId"],
                "properties": {
                    "vendorId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" },
                    "expiresOn": { "type": "string", "format": "date", "nullable": true }
                }
            },
            "RemoveVendorDocumentRequest": {
                "type": "object",
                "required": ["vendorId", "fileId"],
                "properties": {
                    "vendorId": { "type": "string", "description": "ULID" },
                    "fileId": { "type": "string", "description": "ULID" }
                }
            }
        }
    }
}
