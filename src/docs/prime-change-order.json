{
    "paths": {
        "/prime-change-order/project/{projectId}": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "List Prime Change Orders for a project",
                "operationId": "listProjectPrimeChangeOrders",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25 } },
                    {
                        "name": "sortBy",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "referenceNumber",
                                "name",
                                "statusName",
                                "dueDate",
                                "totalCost",
                                "fieldwireCreatedAt",
                                "fieldwireUpdatedAt",
                                "lastSyncedAt"
                            ],
                            "default": "fieldwireUpdatedAt"
                        }
                    },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } },
                    { "name": "search", "in": "query", "schema": { "type": "string" } },
                    { "name": "statusName", "in": "query", "schema": { "type": "string", "enum": ["Draft", "Requested", "Pending Revision", "Pending Approval", "Approved", "Rejected", "Void"] } },
                    { "name": "scheduleImpact", "in": "query", "schema": { "type": "string", "enum": ["yes", "no", "maybe"] } },
                    { "name": "dueDateFrom", "in": "query", "schema": { "type": "string", "format": "date-time" } },
                    { "name": "dueDateTo", "in": "query", "schema": { "type": "string", "format": "date-time" } },
                    { "name": "totalCostMin", "in": "query", "schema": { "type": "number" } },
                    { "name": "totalCostMax", "in": "query", "schema": { "type": "number" } },
                    { "name": "includeDeleted", "in": "query", "schema": { "type": "boolean", "default": false } }
                ],
                "responses": {
                    "200": {
                        "description": "Prime Change Orders returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/PrimeChangeOrder" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Project not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/prime-change-order/project/{projectId}/sync-status": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "Get Prime Change Order sync status for a project",
                "operationId": "getProjectPrimeChangeOrderSyncStatus",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Sync status returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PrimeChangeOrderProjectSyncStatus" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Project not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/prime-change-order/project/{projectId}/status-summary": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "Get Prime Change Order totals grouped by Fieldwire status",
                "operationId": "getProjectPrimeChangeOrderStatusSummary",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Status summary returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/PrimeChangeOrderStatusSummaryItem" }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Project not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/prime-change-order/project/{projectId}/financial-summary": {
            "get": {
                "tags": ["Prime Change Orders"],
                "summary": "Get approved Prime Change Order financial summary for a project",
                "operationId": "getProjectPrimeChangeOrderFinancialSummary",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Financial summary returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PrimeChangeOrderFinancialSummary" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Project not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/prime-change-order/project/{projectId}/sync": {
            "patch": {
                "tags": ["Prime Change Orders"],
                "summary": "Sync Prime Change Orders from Fieldwire for a project",
                "operationId": "syncProjectPrimeChangeOrders",
                "parameters": [
                    { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "Sync completed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PrimeChangeOrderSyncResult" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Project is not mapped to Fieldwire", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Project not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PrimeChangeOrder": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "projectId": { "type": "string" },
                    "fieldwireId": { "type": "string", "format": "uuid" },
                    "creatorUserId": { "type": "integer" },
                    "lastEditorUserId": { "type": "integer" },
                    "fieldwireProjectId": { "type": "string", "format": "uuid" },
                    "fieldwireCreatedAt": { "type": "string", "format": "date-time" },
                    "fieldwireUpdatedAt": { "type": "string", "format": "date-time" },
                    "deviceCreatedAt": { "type": "string", "format": "date-time" },
                    "deviceUpdatedAt": { "type": "string", "format": "date-time" },
                    "fieldwireDeletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "referenceNumber": { "type": "string", "nullable": true },
                    "name": { "type": "string" },
                    "dueDate": { "type": "string", "format": "date-time", "nullable": true },
                    "pmGroupNumber": { "type": "integer", "nullable": true },
                    "totalCost": { "type": "number", "nullable": true },
                    "revisionId": { "type": "string", "format": "uuid" },
                    "statusName": { "type": "string" },
                    "description": { "type": "string", "nullable": true },
                    "assigneeUserId": { "type": "integer", "nullable": true },
                    "externalAssigneeUserId": { "type": "integer", "nullable": true },
                    "scheduleImpact": { "type": "string", "nullable": true },
                    "scheduleImpactDays": { "type": "integer", "nullable": true },
                    "currentRevisionId": { "type": "string", "format": "uuid" },
                    "reasonTypeId": { "type": "string", "format": "uuid", "nullable": true },
                    "lastSyncedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "PrimeChangeOrderSyncRun": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "projectId": { "type": "string" },
                    "trigger": { "type": "string", "enum": ["MANUAL", "SCHEDULED"] },
                    "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] },
                    "startedAt": { "type": "string", "format": "date-time" },
                    "finishedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "totalReceived": { "type": "integer" },
                    "createdCount": { "type": "integer" },
                    "updatedCount": { "type": "integer" },
                    "deletedCount": { "type": "integer" },
                    "error": { "type": "string", "nullable": true },
                    "userId": { "type": "string", "nullable": true }
                }
            },
            "PrimeChangeOrderSyncStatus": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "projectId": { "type": "string" },
                    "lastSyncedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "lastSyncStatus": { "type": "string", "enum": ["SUCCESS", "FAILED"], "nullable": true },
                    "lastSyncError": { "type": "string", "nullable": true },
                    "totalReceived": { "type": "integer" },
                    "createdCount": { "type": "integer" },
                    "updatedCount": { "type": "integer" },
                    "deletedCount": { "type": "integer" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "PrimeChangeOrderProjectSyncStatus": {
                "type": "object",
                "properties": {
                    "projectId": { "type": "string" },
                    "projectName": { "type": "string" },
                    "fieldwireProjectId": { "type": "string", "format": "uuid", "nullable": true },
                    "syncStatus": { "$ref": "#/components/schemas/PrimeChangeOrderSyncStatus" },
                    "latestRun": { "$ref": "#/components/schemas/PrimeChangeOrderSyncRun", "nullable": true }
                }
            },
            "PrimeChangeOrderStatusSummaryItem": {
                "type": "object",
                "properties": {
                    "statusName": { "type": "string", "enum": ["Draft", "Requested", "Pending Revision", "Pending Approval", "Approved", "Rejected", "Void"] },
                    "count": { "type": "integer" },
                    "totalCost": { "type": "number" }
                }
            },
            "PrimeChangeOrderFinancialSummary": {
                "type": "object",
                "properties": {
                    "projectId": { "type": "string" },
                    "originalContractValue": { "type": "number" },
                    "approvedChangeOrdersCount": { "type": "integer" },
                    "approvedChangeOrdersTotal": { "type": "number" },
                    "approvedChangeOrdersPositiveTotal": { "type": "number" },
                    "approvedChangeOrdersNegativeTotal": { "type": "number" },
                    "revisedContractValue": { "type": "number" }
                }
            },
            "PrimeChangeOrderSyncResult": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "object",
                        "properties": {
                            "projectId": { "type": "string" },
                            "fieldwireProjectId": { "type": "string", "format": "uuid" },
                            "status": { "type": "string", "enum": ["SUCCESS"] },
                            "syncedAt": { "type": "string", "format": "date-time" },
                            "totalReceived": { "type": "integer" },
                            "createdCount": { "type": "integer" },
                            "updatedCount": { "type": "integer" },
                            "deletedCount": { "type": "integer" }
                        }
                    },
                    "data": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/PrimeChangeOrder" }
                    }
                }
            }
        }
    }
}
