{
    "paths": {
        "/contact/search": {
            "get": {
                "tags": ["Contacts"],
                "summary": "Search unlinked contacts (not linked to a vendor or GC)",
                "operationId": "searchUnlinkedContacts",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by full name (case-insensitive, partial match)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of unlinked contacts (id and fullName only)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "id": { "type": "string" },
                                                            "fullName": { "type": "string" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires contact:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/contact": {
            "get": {
                "tags": ["Contacts"],
                "summary": "List contacts (paginated)",
                "operationId": "listContacts",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1, "minimum": 1 },
                        "description": "Page number"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": { "type": "integer", "default": 25, "maximum": 100 },
                        "description": "Items per page"
                    },
                    {
                        "name": "sortBy",
                        "in": "query",
                        "schema": { "type": "string", "default": "fullName" },
                        "description": "Field to sort by"
                    },
                    {
                        "name": "sortOrder",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" },
                        "description": "Sort direction"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Search by full name"
                    },
                    {
                        "name": "professionalRoleId",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by CONTACT_PROFESSIONAL_ROLE lookup ULID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of contacts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/Contact" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires contact:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "post": {
                "tags": ["Contacts"],
                "summary": "Create a contact",
                "operationId": "createContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/ContactCreateRequest" }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contact created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "403": {
                        "description": "Insufficient permissions (requires contact:create)",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Linked entity (professional role / vendor / GC) not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": ["Contacts"],
                "summary": "Update a contact (full replace)",
                "operationId": "updateContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/ContactUpdateRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contact updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "403": {
                        "description": "Insufficient permissions (requires contact:update)",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Contact or linked entity not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/contact/{id}": {
            "get": {
                "tags": ["Contacts"],
                "summary": "Get a contact by ID",
                "operationId": "getContact",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Contact ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Contact details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires contact:read)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["Contacts"],
                "summary": "Delete a contact (soft delete)",
                "operationId": "deleteContact",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Contact ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Contact deleted",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires contact:delete)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/contact/tag/add": {
            "patch": {
                "tags": ["Contacts"],
                "summary": "Add a tag to a contact",
                "operationId": "addTagToContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/AddTagToContactRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tag added",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "Tag already exists on contact", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/contact/tag/remove": {
            "patch": {
                "tags": ["Contacts"],
                "summary": "Remove a tag from a contact",
                "operationId": "removeTagFromContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/RemoveTagFromContactRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tag removed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Contact or tag not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/contact/link": {
            "patch": {
                "tags": ["Contacts"],
                "summary": "Link a contact to a vendor OR a general contractor (mutually exclusive; clears the other side)",
                "operationId": "linkContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/LinkContactRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contact linked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error (e.g. both vendorId and generalContractorId provided, or neither)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Contact, vendor, or GC not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/contact/unlink": {
            "patch": {
                "tags": ["Contacts"],
                "summary": "Unlink a contact from its vendor/GC (clears both)",
                "operationId": "unlinkContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/UnlinkContactRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contact unlinked",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Contact" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": { "description": "Contact not found, or contact is not linked to a vendor/GC", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Contact": {
                "type": "object",
                "description": "A contact may be linked to AT MOST one vendor OR one general contractor, never both. Both vendorId and generalContractorId may be null for unaffiliated contacts.",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "fullName": { "type": "string" },
                    "professionalRoleId": { "type": "string", "nullable": true },
                    "professionalRole": { "description": "Lookup row for the professional role; included on get/list responses", "nullable": true },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phoneNumber": { "type": "string", "nullable": true },
                    "tags": { "type": "array", "items": { "type": "string" } },
                    "vendorId": { "type": "string", "nullable": true, "description": "ULID of the vendor this contact belongs to, if any" },
                    "vendor": { "$ref": "#/components/schemas/Vendor", "nullable": true, "description": "Vendor this contact belongs to; included on get/list responses" },
                    "generalContractorId": { "type": "string", "nullable": true, "description": "ULID of the GC this contact belongs to, if any" },
                    "generalContractor": { "$ref": "#/components/schemas/GeneralContractor", "nullable": true, "description": "GC this contact belongs to; included on get/list responses" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
                }
            },
            "ContactCreateRequest": {
                "type": "object",
                "required": ["fullName"],
                "description": "Provide at least one of email or phoneNumber. Set at most one of vendorId or generalContractorId. Providing both is a validation error.",
                "properties": {
                    "fullName": { "type": "string", "minLength": 2 },
                    "professionalRoleId": { "type": "string", "nullable": true, "description": "Existing CONTACT_PROFESSIONAL_ROLE lookup ULID" },
                    "professionalRoleLabel": { "type": "string", "description": "Custom contact professional role label. Mutually exclusive with professionalRoleId; creates or reuses a CONTACT_PROFESSIONAL_ROLE lookup." },
                    "email": { "type": "string", "format": "email", "nullable": true },
                    "phoneNumber": { "type": "string", "minLength": 1, "nullable": true },
                    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "vendorId": { "type": "string", "nullable": true, "description": "ULID of the vendor to link. Mutually exclusive with generalContractorId." },
                    "generalContractorId": { "type": "string", "nullable": true, "description": "ULID of the GC to link. Mutually exclusive with vendorId." }
                }
            },
            "ContactUpdateRequest": {
                "allOf": [
                    { "$ref": "#/components/schemas/ContactCreateRequest" },
                    {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                            "id": { "type": "string", "description": "Contact ULID" }
                        }
                    }
                ]
            },
            "AddTagToContactRequest": {
                "type": "object",
                "required": ["contactId", "tag"],
                "properties": {
                    "contactId": { "type": "string", "description": "ULID" },
                    "tag": { "type": "string", "minLength": 1 }
                }
            },
            "RemoveTagFromContactRequest": {
                "type": "object",
                "required": ["contactId", "tag"],
                "properties": {
                    "contactId": { "type": "string", "description": "ULID" },
                    "tag": { "type": "string", "minLength": 1 }
                }
            },
            "LinkContactRequest": {
                "type": "object",
                "required": ["contactId"],
                "description": "Provide exactly one of vendorId or generalContractorId. The other side is cleared.",
                "properties": {
                    "contactId": { "type": "string", "description": "ULID" },
                    "vendorId": { "type": "string", "description": "Vendor ULID. Mutually exclusive with generalContractorId." },
                    "generalContractorId": { "type": "string", "description": "GC ULID. Mutually exclusive with vendorId." }
                }
            },
            "UnlinkContactRequest": {
                "type": "object",
                "required": ["contactId"],
                "properties": {
                    "contactId": { "type": "string", "description": "ULID" }
                }
            }
        }
    }
}
