{
    "paths": {
        "/general-contractors": {
            "post": {
                "tags": ["General Contractors"],
                "summary": "Create a general contractor",
                "operationId": "createGC",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCCreateRequest" },
                            "example": {
                                "name": "BuildCorp General Contractors",
                                "gcTypeId": "01KHHEXG43WDHY396M9HFP822F",
                                "email": "info@buildcorp.com",
                                "phone": "+1-555-0002",
                                "address": "200 Commerce St, Dallas TX 75201",
                                "website": "https://buildcorp.com",
                                "paymentTerms": "NET_30",
                                "retainagePercent": 10.0,
                                "contacts": [
                                    { "contactId": "01KHHEXG0000CONTACT00001", "isPrimary": true }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "General contractor created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/GeneralContractor" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "GC type or contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "get": {
                "tags": ["General Contractors"],
                "summary": "List general contractors (paginated)",
                "operationId": "listGCs",
                "parameters": [
                    { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by name, email, phone (case-insensitive)" },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "PROSPECTING", "INACTIVE", "BLACKLISTED"] }, "description": "Filter by status" },
                    { "name": "gcTypeId", "in": "query", "schema": { "type": "string" }, "description": "Filter by GC type ID (ULID)" },
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25 }, "description": "Items per page (max 100)" },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" }, "description": "Sort field" },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }, "description": "Sort direction" }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of general contractors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "array", "items": { "$ref": "#/components/schemas/GeneralContractorListItem" } },
                                                "pagination": { "$ref": "#/components/schemas/Pagination" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/stats": {
            "get": {
                "tags": ["General Contractors"],
                "summary": "Get GC KPI metrics",
                "operationId": "getGCStats",
                "responses": {
                    "200": {
                        "description": "GC statistics",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/GCStats" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/{id}": {
            "get": {
                "tags": ["General Contractors"],
                "summary": "Get a single general contractor with relations",
                "operationId": "getGC",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "GC ID (ULID)" }
                ],
                "responses": {
                    "200": {
                        "description": "General contractor details",
                        "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }] } } }
                    },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "put": {
                "tags": ["General Contractors"],
                "summary": "Update general contractor basic info",
                "operationId": "updateGC",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCUpdateRequest" },
                            "example": { "name": "BuildCorp Updated", "paymentTerms": "NET_45" }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }] } } } },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["General Contractors"],
                "summary": "Deactivate general contractor (sets status to INACTIVE)",
                "operationId": "deleteGC",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "Deactivated", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GeneralContractor" } } }] } } } },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/{id}/contacts": {
            "post": {
                "tags": ["General Contractors"],
                "summary": "Add a contact to a general contractor",
                "operationId": "addGCContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "GC ID" }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCContactAddRequest" },
                            "example": { "contactId": "01KHHEXG0000CONTACT00001", "isPrimary": true }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Contact linked", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ContactGCLink" } } }] } } } },
                    "404": { "description": "GC or contact not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "Contact already linked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/{id}/contacts/{contactId}": {
            "put": {
                "tags": ["General Contractors"],
                "summary": "Update a GC contact link",
                "operationId": "updateGCContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCContactUpdateRequest" },
                            "example": { "isPrimary": true }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ContactGCLink" } } }] } } } },
                    "404": { "description": "Link not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["General Contractors"],
                "summary": "Remove a contact from a general contractor",
                "operationId": "removeGCContact",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "Contact removed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "Link not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/types": {
            "get": {
                "tags": ["GC Types"],
                "summary": "List all GC types",
                "operationId": "listGCTypes",
                "responses": {
                    "200": {
                        "description": "List of GC types",
                        "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/GCType" } } } }] } } }
                    }
                }
            },
            "post": {
                "tags": ["GC Types"],
                "summary": "Create a GC type",
                "operationId": "createGCType",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCTypeCreateRequest" },
                            "example": { "name": "Private", "code": "PRIVATE", "description": "Private sector contractors" }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Created", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GCType" } } }] } } } },
                    "409": { "description": "Name or code already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/general-contractors/types/{id}": {
            "put": {
                "tags": ["GC Types"],
                "summary": "Update a GC type",
                "operationId": "updateGCType",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/GCTypeUpdateRequest" },
                            "example": { "description": "Updated description" }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessResponse" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/GCType" } } }] } } } },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["GC Types"],
                "summary": "Delete a GC type",
                "operationId": "deleteGCType",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "409": { "description": "GC type still in use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "GCType": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "code": { "type": "string" },
                    "description": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "GeneralContractor": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "gcTypeId": { "type": "string" },
                    "gcType": { "$ref": "#/components/schemas/GCType" },
                    "status": { "type": "string", "enum": ["ACTIVE", "PROSPECTING", "INACTIVE", "BLACKLISTED"] },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "retainagePercent": { "type": "number" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "contactLinks": { "type": "array", "items": { "$ref": "#/components/schemas/ContactGCLink" } }
                }
            },
            "GeneralContractorListItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "gcTypeId": { "type": "string" },
                    "gcType": { "$ref": "#/components/schemas/GCType" },
                    "status": { "type": "string" },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string" },
                    "retainagePercent": { "type": "number" },
                    "_count": {
                        "type": "object",
                        "properties": {
                            "projects": { "type": "integer" },
                            "contactLinks": { "type": "integer" }
                        }
                    }
                }
            },
            "ContactGCLink": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "contactId": { "type": "string" },
                    "generalContractorId": { "type": "string" },
                    "isPrimary": { "type": "boolean" },
                    "contact": { "$ref": "#/components/schemas/ContactSummary" },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "ContactSummary": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "fullName": { "type": "string" },
                    "email": { "type": "object", "nullable": true },
                    "phoneNumber": { "type": "object", "nullable": true }
                }
            },
            "GCStats": {
                "type": "object",
                "properties": {
                    "totalGCs": { "type": "integer" },
                    "activeProjects": { "type": "integer" },
                    "totalCommitted": { "type": "number" }
                }
            },
            "GCCreateRequest": {
                "type": "object",
                "required": ["name", "gcTypeId"],
                "properties": {
                    "name": { "type": "string" },
                    "gcTypeId": { "type": "string" },
                    "status": { "type": "string", "enum": ["ACTIVE", "PROSPECTING", "INACTIVE", "BLACKLISTED"] },
                    "address": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "phone": { "type": "string" },
                    "website": { "type": "string", "format": "uri" },
                    "paymentTerms": { "type": "string", "enum": ["NET_15", "NET_30", "NET_45", "NET_60", "NET_90", "DUE_ON_RECEIPT"] },
                    "retainagePercent": { "type": "number", "minimum": 0, "maximum": 100 },
                    "contacts": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["contactId"],
                            "properties": {
                                "contactId": { "type": "string" },
                                "isPrimary": { "type": "boolean", "default": false }
                            }
                        }
                    }
                }
            },
            "GCUpdateRequest": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "gcTypeId": { "type": "string" },
                    "status": { "type": "string" },
                    "address": { "type": "string", "nullable": true },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true },
                    "website": { "type": "string", "nullable": true },
                    "paymentTerms": { "type": "string" },
                    "retainagePercent": { "type": "number" }
                }
            },
            "GCContactAddRequest": {
                "type": "object",
                "required": ["contactId"],
                "properties": {
                    "contactId": { "type": "string" },
                    "isPrimary": { "type": "boolean", "default": false }
                }
            },
            "GCContactUpdateRequest": {
                "type": "object",
                "required": ["isPrimary"],
                "properties": {
                    "isPrimary": { "type": "boolean" }
                }
            },
            "GCTypeCreateRequest": {
                "type": "object",
                "required": ["name", "code"],
                "properties": {
                    "name": { "type": "string" },
                    "code": { "type": "string" },
                    "description": { "type": "string" }
                }
            },
            "GCTypeUpdateRequest": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "code": { "type": "string" },
                    "description": { "type": "string", "nullable": true }
                }
            }
        }
    }
}
