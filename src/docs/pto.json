{
    "paths": {
        "/hr/pto": {
            "get": {
                "tags": ["PTO"],
                "summary": "List PTO requests (paginated)",
                "operationId": "listPto",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 }, "description": "Page number" },
                    { "name": "size", "in": "query", "schema": { "type": "integer", "default": 25, "maximum": 100 }, "description": "Items per page" },
                    { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["startDate", "endDate", "status", "createdAt", "updatedAt"], "default": "startDate" }, "description": "Field to sort by" },
                    { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }, "description": "Sort direction" },
                    { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by reason or employee name" }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of PTO requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "array", "items": { "$ref": "#/components/schemas/PaidTimeOff" } },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:view)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "post": {
                "tags": ["PTO"],
                "summary": "Create a PTO request",
                "operationId": "createPto",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PTOCreateRequest" } } }
                },
                "responses": {
                    "201": {
                        "description": "PTO created (status defaults to PENDING)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaidTimeOff" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error (e.g. invalid PTO type, endDate before startDate)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:create)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Employee or PTO type not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "put": {
                "tags": ["PTO"],
                "summary": "Update a PTO request (only allowed while status is PENDING)",
                "operationId": "updatePto",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PTOUpdateRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "PTO updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaidTimeOff" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "Validation error or PTO is not in PENDING status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:create)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "PTO or PTO type not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/hr/pto/{id}": {
            "get": {
                "tags": ["PTO"],
                "summary": "Get a PTO request by ID",
                "operationId": "getPto",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "PTO ID (ULID)" }
                ],
                "responses": {
                    "200": {
                        "description": "PTO details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaidTimeOff" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:view)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "PTO not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            },
            "delete": {
                "tags": ["PTO"],
                "summary": "Delete a PTO request (soft delete)",
                "operationId": "deletePto",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "PTO ID (ULID)" }
                ],
                "responses": {
                    "200": { "description": "PTO deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:create)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "PTO not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/hr/pto/approve": {
            "patch": {
                "tags": ["PTO"],
                "summary": "Approve a PTO request",
                "operationId": "approvePto",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PTOReviewRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "PTO approved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaidTimeOff" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "PTO is already approved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:approve)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "PTO not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/hr/pto/reject": {
            "patch": {
                "tags": ["PTO"],
                "summary": "Reject a PTO request",
                "operationId": "rejectPto",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PTOReviewRequest" } } }
                },
                "responses": {
                    "200": {
                        "description": "PTO rejected",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaidTimeOff" } } }
                                    ]
                                }
                            }
                        }
                    },
                    "400": { "description": "PTO is already rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "403": { "description": "Insufficient permissions (requires leave:approve)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "PTO not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PTOStatus": {
                "type": "string",
                "enum": ["PENDING", "APPROVED", "REJECTED"]
            },
            "PaidTimeOff": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "employeeId": { "type": "string" },
                    "typeId": { "type": "string", "description": "Lookup ID for PTO_TYPE" },
                    "startDate": { "type": "string", "format": "date" },
                    "endDate": { "type": "string", "format": "date" },
                    "reason": { "type": "string", "nullable": true },
                    "status": { "$ref": "#/components/schemas/PTOStatus" },
                    "reviewedById": { "type": "string", "nullable": true },
                    "reviewedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "reviewNote": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "type": { "type": "object", "description": "Lookup row for PTO type" },
                    "employee": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "email": { "type": "string" }
                        }
                    }
                }
            },
            "PTOCreateRequest": {
                "type": "object",
                "required": ["employeeId", "typeId", "startDate", "endDate"],
                "properties": {
                    "employeeId": { "type": "string", "description": "Employee ULID" },
                    "typeId": { "type": "string", "description": "Lookup ULID (type=PTO_TYPE)" },
                    "startDate": { "type": "string", "format": "date" },
                    "endDate": { "type": "string", "format": "date" },
                    "reason": { "type": "string" }
                }
            },
            "PTOUpdateRequest": {
                "type": "object",
                "required": ["id"],
                "properties": {
                    "id": { "type": "string", "description": "PTO ULID" },
                    "typeId": { "type": "string" },
                    "startDate": { "type": "string", "format": "date" },
                    "endDate": { "type": "string", "format": "date" },
                    "reason": { "type": "string", "nullable": true }
                }
            },
            "PTOReviewRequest": {
                "type": "object",
                "required": ["id"],
                "properties": {
                    "id": { "type": "string", "description": "PTO ULID" },
                    "note": { "type": "string", "description": "Optional reviewer note" }
                }
            }
        }
    }
}
