{
    "paths": {
        "/revision/{entityType}/{entityId}": {
            "get": {
                "tags": ["Revision"],
                "summary": "List revisions for an entity (newest version first, metadata only)",
                "operationId": "listRevisions",
                "parameters": [
                    {
                        "name": "entityType",
                        "in": "path",
                        "required": true,
                        "schema": { "$ref": "#/components/schemas/RevisionEntityType" }
                    },
                    {
                        "name": "entityId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "ULID of the parent entity"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1, "minimum": 1 }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": { "type": "integer", "default": 25, "maximum": 100 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated revision metadata, newest version first. Snapshot body is excluded — fetch /revision/{id} for full snapshot.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/RevisionSummary" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        },
        "/revision/{id}": {
            "get": {
                "tags": ["Revision"],
                "summary": "Get one revision including the full pre-update snapshot",
                "operationId": "getRevision",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Revision ULID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Revision with snapshot",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Revision" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
                    "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RevisionEntityType": {
                "type": "string",
                "enum": ["RFQ", "PURCHASE_ORDER", "SUB_CHANGE_ORDER", "INVOICE", "PROJECT"]
            },
            "RevisionSummary": {
                "type": "object",
                "description": "Lightweight revision metadata (no snapshot body).",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "entityType": { "$ref": "#/components/schemas/RevisionEntityType" },
                    "entityId": { "type": "string", "description": "Parent entity ULID" },
                    "version": { "type": "integer", "description": "1-based version number, monotonically increasing per entity" },
                    "changeNote": { "type": "string", "nullable": true },
                    "createdById": { "type": "string" },
                    "createdBy": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "email": { "type": "string" },
                            "image": { "type": "string", "nullable": true }
                        }
                    },
                    "createdAt": { "type": "string", "format": "date-time" }
                }
            },
            "Revision": {
                "allOf": [
                    { "$ref": "#/components/schemas/RevisionSummary" },
                    {
                        "type": "object",
                        "properties": {
                            "snapshot": {
                                "type": "object",
                                "description": "Full pre-update state of the entity at the moment this revision was created. Includes line items / deliverables / attachment metadata where applicable. Shape mirrors the corresponding entity's GET response."
                            }
                        }
                    }
                ]
            }
        }
    }
}
