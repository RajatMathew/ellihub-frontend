{
    "paths": {
        "/seed/run": {
            "post": {
                "tags": ["Seeder"],
                "summary": "Run all seed scripts",
                "description": "Kicks off the seed scripts (cost codes, professional roles, vendor types, GC types, root folder) in the background and returns immediately with 202. Each script runs in its own subprocess; output is logged to the API server's stdout/stderr. Gated by the `x-seed-key` header which must match the `SEED_API_KEY` env var. If `SEED_API_KEY` is unset, the endpoint is disabled.",
                "operationId": "runSeeders",
                "parameters": [
                    {
                        "name": "x-seed-key",
                        "in": "header",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Shared secret matching SEED_API_KEY"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Seeders accepted and running in background",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/SeederRunAccepted" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid seed key",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    },
                    "403": {
                        "description": "Seeder endpoint disabled (SEED_API_KEY not set)",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "SeederRunAccepted": {
                "type": "object",
                "properties": {
                    "status": { "type": "string", "enum": ["started"] },
                    "scripts": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Names of seed scripts that will run, in order"
                    }
                }
            }
        }
    }
}
