{
    "paths": {
        "/file/search": {
            "get": {
                "tags": ["File"],
                "summary": "Search and filter files and folders",
                "operationId": "searchFiles",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Search by file/folder name"
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["FILE", "FOLDER"] },
                        "description": "Filter by type"
                    },
                    {
                        "name": "mimeType",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by MIME type (partial match)"
                    },
                    {
                        "name": "parentId",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by parent folder ID"
                    },
                    {
                        "name": "createdBy",
                        "in": "query",
                        "schema": { "type": "string" },
                        "description": "Filter by creator user ID"
                    },
                    {
                        "name": "createdFrom",
                        "in": "query",
                        "schema": { "type": "string", "format": "date-time" },
                        "description": "Filter by creation date (from)"
                    },
                    {
                        "name": "createdTo",
                        "in": "query",
                        "schema": { "type": "string", "format": "date-time" },
                        "description": "Filter by creation date (to)"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1 },
                        "description": "Page number"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "schema": { "type": "integer", "default": 25, "maximum": 100 },
                        "description": "Items per page"
                    },
                    {
                        "name": "sortBy",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["name", "size", "createdAt", "updatedAt", "type", "mimeType"], "default": "createdAt" },
                        "description": "Field to sort by"
                    },
                    {
                        "name": "sortOrder",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
                        "description": "Sort direction"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of files and folders",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/FileItem" }
                                                },
                                                "pagination": { "$ref": "#/components/schemas/PaginationInfo" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/upload": {
            "post": {
                "tags": ["File"],
                "summary": "Upload a file",
                "operationId": "uploadFile",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "File to upload"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "File uploaded successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/download/{id}": {
            "get": {
                "tags": ["File"],
                "summary": "Get download link for a file",
                "operationId": "getDownloadLink",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "File ID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Download link generated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Presigned download URL" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/root": {
            "get": {
                "tags": ["File"],
                "summary": "Get root folder ID",
                "operationId": "getRootFolder",
                "responses": {
                    "200": {
                        "description": "Root folder ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Root folder ULID" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/folder": {
            "post": {
                "tags": ["File"],
                "summary": "Create a new folder",
                "operationId": "createFolder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/FolderCreateRequest" }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Folder created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Folder" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/rename": {
            "put": {
                "tags": ["File"],
                "summary": "Rename a file or folder",
                "operationId": "renameFileOrFolder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/FileFolderRenameRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "File or folder renamed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "object" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File or folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/folder/{id}/breadcrumbs": {
            "get": {
                "tags": ["File"],
                "summary": "Get folder breadcrumbs from root",
                "operationId": "getFolderBreadcrumbs",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Folder ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Breadcrumbs from root to the given folder",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": { "$ref": "#/components/schemas/Breadcrumb" }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/folder/{id}": {
            "get": {
                "tags": ["File"],
                "summary": "Get folder details",
                "operationId": "getFolderDetails",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Folder ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Folder details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/Folder" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": ["File"],
                "summary": "Delete a folder",
                "operationId": "deleteFolder",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Folder ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Folder deleted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "object" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/project/{projectId}/folder": {
            "get": {
                "tags": ["File"],
                "summary": "Get project root folder ID",
                "operationId": "getProjectFolderId",
                "parameters": [
                    {
                        "name": "projectId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Project ID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project root folder ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Project root folder ID" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Project folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/project/{projectId}/folder/{type}": {
            "get": {
                "tags": ["File"],
                "summary": "Get project sub-folder ID by type",
                "operationId": "getProjectSubFolderId",
                "parameters": [
                    {
                        "name": "projectId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Project ID"
                    },
                    {
                        "name": "type",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": ["INVOICE", "RFQ", "PURCHASE_ORDER", "PURCHASE_ORDER_CO", "PRIME_CO", "PRIME_CONTRACT"]
                        },
                        "description": "Protected folder type"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Project sub-folder ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Sub-folder ID" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Project or sub-folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/{id}": {
            "delete": {
                "tags": ["File"],
                "summary": "Delete a file",
                "operationId": "deleteFile",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "File ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File deleted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "object" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FolderCreateRequest": {
                "type": "object",
                "required": ["name", "parentId"],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Folder name",
                        "example": "Documents"
                    },
                    "parentId": {
                        "type": "string",
                        "description": "Parent folder ULID",
                        "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
                    }
                }
            },
            "FileFolderRenameRequest": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "File or folder ULID",
                        "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "New name",
                        "example": "Updated Name"
                    }
                }
            },
            "FileItem": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "description": "File/folder ULID" },
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["FILE", "FOLDER"] },
                    "mimeType": { "type": "string", "nullable": true },
                    "size": { "type": "integer", "nullable": true },
                    "parentId": { "type": "string", "nullable": true },
                    "createdBy": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "Breadcrumb": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Folder ULID"
                    },
                    "name": {
                        "type": "string",
                        "description": "Folder name"
                    }
                }
            },
            "Folder": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Folder ULID"
                    },
                    "name": {
                        "type": "string",
                        "description": "Folder name"
                    },
                    "parentId": {
                        "type": "string",
                        "description": "Parent folder ULID",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
