{
    "paths": {
        "/file/upload": {
            "post": {
                "tags": ["File"],
                "summary": "Upload a file",
                "operationId": "uploadFile",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "required": ["file", "data"],
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "File to upload"
                                    },
                                    "data": {
                                        "type": "string",
                                        "description": "JSON string with file metadata: {\"name\": \"file.pdf\", \"parentId\": \"ULID\", \"size\": 1024, \"mimeType\": \"application/pdf\"}"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "File uploaded successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Success message" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request - invalid file or metadata",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/download/{id}": {
            "get": {
                "tags": ["File"],
                "summary": "Get download link for a file",
                "operationId": "getDownloadLink",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "File ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Download link generated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Presigned download URL" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/root": {
            "get": {
                "tags": ["File"],
                "summary": "Get root folder ID",
                "operationId": "getRootFolder",
                "responses": {
                    "200": {
                        "description": "Root folder ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "type": "string", "description": "Root folder ULID" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/folder": {
            "post": {
                "tags": ["File"],
                "summary": "Create a new folder",
                "operationId": "createFolder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/FolderCreateRequest" }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Folder created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/FileItem" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request - protected folder name or invalid parent",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/rename": {
            "put": {
                "tags": ["File"],
                "summary": "Rename a file or folder",
                "operationId": "renameFileOrFolder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/FileFolderRenameRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "File or folder renamed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/FileItem" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request - protected or non-deletable item",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File or folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/folder/{id}": {
            "get": {
                "tags": ["File"],
                "summary": "Get folder details with children",
                "operationId": "getFolderDetails",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Folder ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Folder details with children",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        { "$ref": "#/components/schemas/SuccessResponse" },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": { "$ref": "#/components/schemas/FolderWithChildren" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": ["File"],
                "summary": "Delete a folder (soft delete)",
                "operationId": "deleteFolder",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "Folder ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Folder deleted successfully",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request - folder not empty or non-deletable",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "Folder not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/file/{id}": {
            "delete": {
                "tags": ["File"],
                "summary": "Delete a file (soft delete)",
                "operationId": "deleteFile",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" },
                        "description": "File ID (ULID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File deleted successfully",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request - non-deletable file",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/file/read": {
            "get": {
                "tags": ["File"],
                "summary": "Read a file (public - no auth required)",
                "operationId": "readFile",
                "security": [],
                "responses": {
                    "200": {
                        "description": "File content"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FileItem": {
                "type": "object",
                "description": "Represents a file or folder in the hierarchical file system",
                "properties": {
                    "id": { "type": "string", "description": "ULID" },
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["FILE", "FOLDER"] },
                    "parentId": { "type": "string", "nullable": true, "description": "Parent folder ULID (null for root)" },
                    "objectId": { "type": "string", "nullable": true, "description": "S3 object key (for files)" },
                    "mimeType": { "type": "string", "nullable": true, "description": "MIME type (for files)" },
                    "size": { "type": "integer", "nullable": true, "description": "File size in bytes" },
                    "isDeletable": { "type": "boolean", "description": "Whether this item can be deleted" },
                    "private": { "type": "boolean" },
                    "createdBy": { "type": "string", "description": "User ID who created this item" },
                    "deletedBy": { "type": "string", "nullable": true, "description": "User ID who deleted this item" },
                    "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                }
            },
            "FolderWithChildren": {
                "allOf": [
                    { "$ref": "#/components/schemas/FileItem" },
                    {
                        "type": "object",
                        "properties": {
                            "children": {
                                "type": "array",
                                "items": { "$ref": "#/components/schemas/FileItem" },
                                "description": "Child files and folders"
                            }
                        }
                    }
                ]
            },
            "FolderCreateRequest": {
                "type": "object",
                "required": ["name", "parentId"],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Folder name (cannot use protected names: root, projects, rfq, etc.)",
                        "example": "Documents"
                    },
                    "parentId": {
                        "type": "string",
                        "description": "Parent folder ULID",
                        "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
                    }
                }
            },
            "FileFolderRenameRequest": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "File or folder ULID",
                        "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "New name",
                        "example": "Updated Name"
                    }
                }
            },
            "FileUploadData": {
                "type": "object",
                "required": ["name", "parentId", "size"],
                "description": "Metadata sent as JSON string in the 'data' form field",
                "properties": {
                    "name": { "type": "string", "minLength": 1, "description": "File name" },
                    "parentId": { "type": "string", "description": "Parent folder ULID" },
                    "size": { "type": "integer", "description": "File size in bytes" },
                    "mimeType": { "type": "string", "description": "MIME type (optional)" }
                }
            }
        }
    }
}
