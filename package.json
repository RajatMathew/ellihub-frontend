{
    "name": "elli-core",
    "version": "0.1.0",
    "private": true,
    "description": "Core API for Elli application",
    "author": "Mohammed Yasim <yasim@azba.in>",
    "scripts": {
        "predev": "bun node_modules/prisma/build/index.js generate",
        "auth:generate": "bunx @better-auth/cli generate --output=./prisma/schema/auth.prisma",
        "dev": "bun run --hot src/index.ts",
        "lint": "eslint --ext .ts src/",
        "format": "prettier --write src/",
        "prebuild": "bun node_modules/prisma/build/index.js generate && vitepress build docs && bun run api:build",
        "build": "bun build src/index.ts --outdir=dist --target=bun",
        "postbuild": "echo Build completed!",
        "start": "bun dist/index.js",
        "prepare": "husky",
        "db:migrate": "bun node_modules/prisma/build/index.js migrate dev",
        "db:generate": "bun node_modules/prisma/build/index.js generate",
        "db:reset": "scripts/seederV2/reset-dev-db.sh",
        "db:studio": "prisma studio",
        "test": "bun test",
        "benchmark:email": "bun run scripts/benchmark-email-cache.ts",
        "typecheck": "tsc --noEmit",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs && bun run scripts/build-openapi.ts",
        "docs:preview": "vitepress preview docs",
        "docker:up": "docker compose up --build",
        "docker:down": "docker compose down",
        "db:seed:prod": "bun run scripts/seederV2/production.ts",
        "db:seed:dev": "bun run scripts/seederV2/development.ts",
        "api:build": "bun run scripts/build-openapi.ts",
        "test:quickbooks": "bun test src/modules/integrations/quickbooks.test.ts",
        "test:quickbooks:live": "QUICKBOOKS_LIVE_TESTS=1 bun test src/modules/integrations/quickbooks.live.test.ts",
        "test:quickbooks:live:mutations": "QUICKBOOKS_LIVE_TESTS=1 QUICKBOOKS_LIVE_MUTATION_TESTS=1 bun test src/modules/integrations/quickbooks.live.test.ts"
    },
    "dependencies": {
        "@hono/swagger-ui": "^0.5.2",
        "@hono/zod-openapi": "^1.1.5",
        "@prisma/adapter-pg": "^7.0.1",
        "@prisma/client": "^7.8.0",
        "@types/pg": "^8.15.6",
        "axios": "^1.13.2",
        "better-auth": "^1.4.18",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.2.3",
        "hono": "^4.10.7",
        "nanoid": "^5.1.11",
        "node-schedule": "^2.1.1",
        "pg": "^8.16.3",
        "tsx": "^4.21.0",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@faker-js/faker": "^10.4.0",
        "@types/bun": "latest",
        "@types/node-schedule": "^2.1.8",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "bun-types": "^1.3.3",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.7.3",
        "prisma": "^7.8.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.0",
        "vitepress": "^1.6.4",
        "vue": "^3.5.25"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
