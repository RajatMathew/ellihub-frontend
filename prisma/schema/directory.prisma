model Vendor {
  id           String       @id
  name         String
  type         VendorType
  categoryTags String[]
  taxId        String?
  status       VendorStatus
  address      String?
  email        String?
  phone        String?
  website      String?
  paymentTerms PaymentTerms @default(NET_30)
  notes        String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rfqs           RFQ[]
  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]
  contactLinks   ContactVendor[]

  @@index([name])
  @@index([status])
  @@index([type])
}

enum PaymentTerms {
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  DUE_ON_RECEIPT
}

enum VendorType {
  MATERIAL
  FABRICATION
  INSTALLATION
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PROSPECT
}

model GCType {
  id          String @id
  name        String @unique
  code        String @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generalContractors GeneralContractor[]

  @@index([name])
  @@index([code])
}

model GeneralContractor {
  id               String       @id
  name             String
  gcTypeId         String
  gcType           GCType       @relation(fields: [gcTypeId], references: [id])
  status           GCStatus     @default(ACTIVE)
  address          String?
  email            String?
  phone            String?
  website          String?
  paymentTerms     PaymentTerms @default(NET_30)
  retainagePercent Float        @default(10.0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects     Project[]
  contactLinks ContactGC[]

  @@index([name])
  @@index([status])
  @@index([gcTypeId])
  @@index([deletedAt])
}

enum GCStatus {
  ACTIVE
  PROSPECTING
  INACTIVE
  BLACKLISTED
}

enum PaymentTerms {
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  DUE_ON_RECEIPT
}

model ProfessionalRole {
  id   String @id
  name String @unique

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts Contact[]
}

model Contact {
  id                 String            @id
  fullName           String
  professionalRoleId String?
  professionalRole   ProfessionalRole? @relation(fields: [professionalRoleId], references: [id])
  email              Json?
  phoneNumber        Json?
  tags               String[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendorLinks ContactVendor[]
  gcLinks     ContactGC[]

  @@index([fullName])
  @@index([deletedAt])
}

model ContactVendor {
  id        String  @id
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, vendorId])
}

model ContactGC {
  id                  String            @id
  contactId           String
  contact             Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  generalContractorId String
  generalContractor   GeneralContractor @relation(fields: [generalContractorId], references: [id], onDelete: Cascade)
  isPrimary           Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, generalContractorId])
}

model CostCodeCategory {
  id          String    @id
  name        String
  description String?
  tenantId    String    @default("default")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  costCodes CostCode[]

  @@index([deletedAt])
  @@index([tenantId])
}

model CostCode {
  id                 String           @id
  name               String
  code               String
  tenantId           String           @default("default")
  description        String           @default("")
  costCodeCategory   CostCodeCategory @relation(fields: [costCodeCategoryId], references: [id])
  costCodeCategoryId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([code, tenantId])
  @@index([code])
  @@index([deletedAt])
  @@index([tenantId])
}
