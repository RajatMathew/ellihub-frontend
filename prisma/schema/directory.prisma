model Vendor {
  id      String       @id
  name    String
  type    VendorType
  taxId   String
  status  VendorStatus
  address String?
  email   String?
  phone   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rfqs RFQ[]

  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]
}

enum VendorType {
  MATERIAL
  FABRICATION
  INSTALLATION
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PROSPECT
}

model GeneralContractor {
  id      String   @id
  name    String
  type    GCType
  status  GCStatus
  address String?
  email   String?
  phone   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects Project[]
}

enum GCType {
  PUBLIC
  PRIVATE
  INSTITUTIONAL
  CIVIL
}

enum GCStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model ProfessionalRole {
  id   String @id
  name String @unique

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts Contact[]
}

model ContactEntityType {
  id   String @id
  name String @unique

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entityLinks ContactEntityLink[]
}

model Contact {
  id                 String            @id
  fullName           String
  professionalRoleId String?
  professionalRole   ProfessionalRole? @relation(fields: [professionalRoleId], references: [id])
  emails             Json
  phoneNumbers       Json
  tags               String[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entityLinks ContactEntityLink[]

  @@index([fullName])
  @@index([deletedAt])
}

model ContactEntityLink {
  id           String            @id
  contactId    String
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityTypeId String
  entityType   ContactEntityType @relation(fields: [entityTypeId], references: [id])
  entityId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, entityTypeId, entityId])
}

model CostCodeCategory {
  id          String    @id
  name        String
  description String?
  tenantId    String    @default("default")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  costCodes CostCode[]

  @@index([deletedAt])
  @@index([tenantId])
}

model CostCode {
  id                 String           @id
  name               String
  code               String
  tenantId           String           @default("default")
  description        String           @default("")
  costCodeCategory   CostCodeCategory @relation(fields: [costCodeCategoryId], references: [id])
  costCodeCategoryId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([code, tenantId])
  @@index([code])
  @@index([deletedAt])
  @@index([tenantId])
}
