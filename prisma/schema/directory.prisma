model Vendor {
    id           String       @id
    name         String
    type         Lookup?      @relation(fields: [typeId], references: [id])
    typeId       String?
    categoryTags String[]
    taxId        String?
    status       VendorStatus
    address      String?
    email        String?
    phone        String?
    website      String?
    fax          String?
    paymentTerms PaymentTerms @default(NET_30)
    notes        String?

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    contactLinks ContactVendor[]
    documents    VendorDocument[]

    @@index([name])
    @@index([status])
}

model VendorDocument {
    id       String @id
    fileId   String
    file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
    vendorId String
    vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

    expiresOn DateTime? @db.Date

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([vendorId, fileId])
    @@index([fileId])
}

enum PaymentTerms {
    NET_15
    NET_30
    NET_45
    NET_60
    NET_90
    DUE_ON_RECEIPT
}

enum VendorStatus {
    ACTIVE
    INACTIVE
}

model GeneralContractor {
    id               String       @id
    name             String
    gcTypeId         String
    gcType           Lookup       @relation(fields: [gcTypeId], references: [id])
    status           GCStatus     @default(ACTIVE)
    address          String?
    email            String?
    phone            String?
    website          String?
    fax              String?
    paymentTerms     PaymentTerms @default(NET_30)
    retainagePercent Float        @default(10.0)

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    contactLinks ContactGC[]
    documents    GCDocument[]

    @@index([name])
    @@index([status])
    @@index([gcTypeId])
    @@index([deletedAt])
}

enum GCStatus {
    ACTIVE
    INACTIVE
}

model GCDocument {
    id     String            @id
    gcId   String
    gc     GeneralContractor @relation(fields: [gcId], references: [id], onDelete: Cascade)
    fileId String
    file   File              @relation(fields: [fileId], references: [id], onDelete: Cascade)

    expiresOn DateTime? @db.Date

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([gcId, fileId])
    @@index([fileId])
}

model Contact {
    id                 String   @id
    fullName           String
    professionalRoleId String?
    professionalRole   Lookup?  @relation(fields: [professionalRoleId], references: [id])
    email              Json?
    phoneNumber        Json?
    tags               String[]

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    vendorLinks ContactVendor[]
    gcLinks     ContactGC[]

    @@index([fullName])
    @@index([deletedAt])
}

model ContactVendor {
    id        String  @id
    contactId String
    contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
    vendorId  String
    vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    isPrimary Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([contactId, vendorId])
}

model ContactGC {
    id                  String            @id
    contactId           String
    contact             Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
    generalContractorId String
    generalContractor   GeneralContractor @relation(fields: [generalContractorId], references: [id], onDelete: Cascade)
    isPrimary           Boolean           @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([contactId, generalContractorId])
}
