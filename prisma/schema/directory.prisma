enum AddressType {
  BILLING
  OFFICE
  SITE
  OTHER

  @@schema("directory")
}

model Address {
  id                 String       @id @default(uuid())
  type               AddressType
  street1            String
  street2            String?
  city               String
  state              String
  postalCode         String
  country            String
  timezone           String       @default("US/Eastern") // Use US/IST timezone Standard
  // Back-relations to Vendor
  vendorId           String?
  billingVendor      Vendor?      @relation("VendorBillingAddress")
  primaryVendor      Vendor?      @relation("VendorPrimaryAddress")
  shippingVendor     Vendor?      @relation("VendorShippingAddress")
  vendors            Vendor[]     @relation("VendorAddresses")
  // Back-relation to Contractor
  contractorId       String?
  billingContractor  Contractor?  @relation("ContractorBillingAddress")
  primaryContractor  Contractor?  @relation("ContractorPrimaryAddress")
  shippingContractor Contractor?  @relation("ContractorShippingAddress")
  contractors        Contractor[] @relation("ContractorAddresses")

  @@schema("directory")
}

model Contact {
  id                String      @id @default(uuid())
  fullName          String
  title             String?
  phone             String?
  email             String?
  notes             String?
  // Vendor relation
  vendorId          String?
  vendors           Vendor?     @relation("AllVendorContacts", fields: [vendorId], references: [id])
  vendorPrimary     Vendor?     @relation("VendorPrimaryContact")
  // Contractor relation
  contractorId      String?
  contractors       Contractor? @relation("AllContractorContacts", fields: [contractorId], references: [id])
  contractorPrimary Contractor? @relation("ContractorPrimaryContact")

  @@schema("directory")
}

model Contractor {
  id                String    @id @default(uuid())
  name              String
  taxId             String
  licenseNumber     String?
  licenseState      String?
  prequalified      Boolean   @default(false)
  bondingCapacity   Decimal?
  // Status
  status            Status    @default(ACTIVE)
  // Contacts Relation
  primaryContactId  String?   @unique
  primaryContact    Contact?  @relation("ContractorPrimaryContact", fields: [primaryContactId], references: [id])
  contacts          Contact[] @relation("AllContractorContacts")
  /// Addresses Relations (Primary, Billing, Shipping)
  billingAddressId  String?   @unique
  primaryAddressId  String?   @unique
  shippingAddressId String?   @unique
  billingAddress    Address?  @relation("ContractorBillingAddress", fields: [billingAddressId], references: [id])
  primaryAddress    Address?  @relation("ContractorPrimaryAddress", fields: [primaryAddressId], references: [id])
  shippingAddress   Address?  @relation("ContractorShippingAddress", fields: [shippingAddressId], references: [id])
  addresses         Address[] @relation("ContractorAddresses")
  /// Notes Relation
  Notes             Note[]    @relation("ContractorNotes")
  // Projects Relation
  projects          Project[] @relation("ContractorProjects")

  @@schema("directory")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED

  @@schema("directory")
}

model VendorType {
  id   String @id @default(uuid())
  name String @unique

  vendors Vendor[] @relation("VendorTypeVendors")

  @@schema("directory")
}

model Vendor {
  id                      String           @id @default(uuid())
  vendorTypeId            String
  vendorType              VendorType       @relation("VendorTypeVendors", fields: [vendorTypeId], references: [id])
  // Basic Info
  name                    String
  taxId                   String
  // Status
  status                  VendorStatus     @default(ACTIVE)
  defaultPaymentTerms     String?
  defaultRetainagePercent Decimal?
  // Insurance Expiry Dates
  insuranceGlExpiry       DateTime?
  insuranceWcExpiry       DateTime?
  insuranceUmbrellaExpiry DateTime?
  complianceStatus        ComplianceStatus @default(COMPLIANT)
  // Contacts Relation
  primaryContactId        String?          @unique
  primaryContact          Contact?         @relation("VendorPrimaryContact", fields: [primaryContactId], references: [id])
  contacts                Contact[]        @relation("AllVendorContacts")
  // Addresses Relations (Billing and Shipping)
  billingAddressId        String?          @unique
  primaryAddressId        String?          @unique
  shippingAddressId       String?          @unique
  billingAddress          Address?         @relation("VendorBillingAddress", fields: [billingAddressId], references: [id])
  primaryAddress          Address?         @relation("VendorPrimaryAddress", fields: [primaryAddressId], references: [id])
  shippingAddress         Address?         @relation("VendorShippingAddress", fields: [shippingAddressId], references: [id])
  addresses               Address[]        @relation("VendorAddresses")
  // Services offered by the vendor
  services                Service[]
  // Notes Relation
  Notes                   Note[]           @relation("VendorNotes")

  // Projects Relation
  @@schema("directory")
}

model Service {
  id          String  @id @default(uuid())
  vendorId    String
  name        String
  description String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@schema("directory")
}

model Note {
  id           String      @id @default(uuid())
  content      String
  createdBy    String?
  createdAt    DateTime    @default(now())
  // Relations
  vendorId     String?
  contractorId String?
  vendor       Vendor?     @relation("VendorNotes", fields: [vendorId], references: [id])
  contractor   Contractor? @relation("ContractorNotes", fields: [contractorId], references: [id])

  @@schema("directory")
}

// -----------------------------
//  Enums
// -----------------------------

enum Status {
  ACTIVE
  INACTIVE

  @@schema("directory")
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  UNKNOWN

  @@schema("directory")
}
