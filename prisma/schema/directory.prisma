model Client {
  id          String     @id @default(uuid())
  clientType  ClientType
  companyName String
  website     String?
  phone       String?
  email       String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  addresses         Address[]
  contacts          Contact[]
  notes             Note[]
  generalContractor GeneralContractor?
  vendor            Vendor?

  projects Project[] @relation("ClientProjects")

  @@schema("directory")
}

model Address {
  id         String      @id @default(uuid())
  clientId   String
  type       AddressType
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String
  isPrimary  Boolean     @default(false)

  client Client @relation(fields: [clientId], references: [id])

  @@schema("directory")
}

model Contact {
  id       String  @id @default(uuid())
  clientId String
  fullName String
  title    String?
  phone    String?
  email    String?
  notes    String?

  client Client @relation(fields: [clientId], references: [id])

  @@schema("directory")
}

model GeneralContractor {
  id              String   @id @default(uuid())
  clientId        String   @unique
  licenseNumber   String?
  licenseState    String?
  prequalified    Boolean  @default(false)
  bondingCapacity Decimal?

  client Client @relation(fields: [clientId], references: [id])

  @@schema("directory")
}

model Vendor {
  id                 String  @id @default(uuid())
  clientId           String  @unique
  serviceCategory    String?
  serviceDescription String?
  w9OnFile           Boolean @default(false)

  client   Client    @relation(fields: [clientId], references: [id])
  services Service[]

  @@schema("directory")
}

model Service {
  id          String  @id @default(uuid())
  vendorId    String
  name        String
  description String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@schema("directory")
}

model Note {
  id        String   @id @default(uuid())
  clientId  String
  content   String
  createdBy String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@schema("directory")
}

// -----------------------------
//  Enums
// -----------------------------

enum ClientType {
  GENERAL_CONTRACTOR
  VENDOR

  @@schema("directory")
}

enum Status {
  ACTIVE
  INACTIVE

  @@schema("directory")
}

enum AddressType {
  BILLING
  OFFICE
  SITE
  OTHER

  @@schema("directory")
}
