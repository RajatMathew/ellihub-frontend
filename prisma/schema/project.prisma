model Project {
    id             String  @id
    name           String
    description    String
    jobNumber      String? @unique
    contractNumber String?

    stage      Lookup        @relation(fields: [stageId], references: [id], name: "project_stage")
    stageId    String
    division   Lookup        @relation(fields: [divisionId], references: [id], name: "project_division")
    divisionId String
    status     ProjectStatus

    streetAddress String?
    city          String?
    state         String?
    zipCode       String?

    estimatedStartDate DateTime?
    estimatedEndDate   DateTime?

    gc       GeneralContractor @relation(fields: [gcId], references: [id])
    gcId     String
    leadPM   Employee?         @relation(fields: [leadPMId], references: [id])
    leadPMId String?

    contractValue       Decimal
    contractType        String?
    retainagePercent    Decimal?      @db.Decimal(5, 2)
    targetBudgetPercent Decimal?      @db.Decimal(5, 2)
    taxRate             Decimal?      @default(0) @db.Decimal(5, 2)
    paymentTerms        PaymentTerms?

    startDate       DateTime?
    completedDate   DateTime?
    closedDate      DateTime?
    setInactiveDate DateTime?
    tcoDate         DateTime?

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    teamMembers      ProjectTeamMember[]
    primeContract    PrimeContract[]
    projectSchedules ProjectSchedule[]

    @@index([stageId])
    @@index([status])
    @@index([gcId])
    @@index([leadPMId])
}

enum ProjectStatus {
    ACTIVE
    INACTIVE
    CLOSED
    COMPLETED
}

model ProjectTeamMember {
    employeeId String
    projectId  String
    role       String
    isLead     Boolean @default(false)

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@id([employeeId, projectId])
    @@index([projectId])
}

model PrimeContract {
    id         String   @id
    project    Project  @relation(fields: [projectId], references: [id])
    projectId  String   @unique
    fileId     String
    file       File     @relation(fields: [fileId], references: [id])
    uploadedAt DateTime @default(now())

    @@index([projectId])
}

model ProjectSchedule {
    id                 String    @id
    project            Project   @relation(fields: [projectId], references: [id])
    projectId          String
    date               DateTime
    description        String
    adjustedFinishDate DateTime?
    notes              String?
    file               File?     @relation(fields: [fileId], references: [id])
    fileId             String?   @unique
    deletedAt          DateTime?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    @@index([projectId])
}

model RFQ {
    id        String  @id
    project   Project @relation(fields: [projectId], references: [id])
    projectId String

    rfqNumber   String  @unique
    title       String
    description String? @db.Text

    status RFQStatus

    bidDeadline DateTime

    track TradeCategory @default(MATERIAL)

    awardedVendor   Vendor?  @relation(fields: [awardedVendorId], references: [id])
    awardedVendorId String?
    awardedAmount   Decimal? @db.Decimal(15, 2)

    // generatedPO   PurchaseOrder? @relation("RFQGeneratedPO", fields: [generatedPOId], references: [id])
    // generatedPOId String?        @unique

    publishedBy        String?
    publishedAt        DateTime?
    awardedBy          String?
    awardedAt          DateTime?
    cancelledBy        String?
    cancelledAt        DateTime?
    cancellationReason String?

    createdById String
    createdBy   Employee

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([projectId])
    @@index([statusId])
    @@index([bidDeadline])
}
