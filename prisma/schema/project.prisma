model Project {
  id       String            @id
  gc       GeneralContractor @relation(fields: [gcId], references: [id])
  gcId     String
  leadPMId String

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primeContract PrimeContract?

  projectScheduleEntries ProjectScheduleEntry[]
}

model PrimeContract {
  id        String   @id
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String   @unique
    deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTeamAssignment {
  projectId  String
  employeeId String
  role       String

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([projectId, employeeId])
}

model ProjectScheduleEntry {
  id          String   @id
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String   @unique
  date        DateTime
  description String
  
    deletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


