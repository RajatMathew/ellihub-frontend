model Project {
  id             String  @id
  name           String
  description    String
  jobNumber      String? @unique
  contractNumber String?

  stage    ProjectStage    @relation(fields: [stageId], references: [id])
  stageId  String
  division ProjectDivision
  statusId String
  status   ProjectStatus   @relation(fields: [statusId], references: [id])

  streetAddress String?
  city          String?
  state         String?
  zipCode       String?

  effectiveStartDate DateTime?
  effectiveEndDate   DateTime?

  gc                     GeneralContractor       @relation(fields: [gcId], references: [id])
  gcId                   String
  leadPM                 Employee                @relation(fields: [leadPMId], references: [id])
  leadPMId               String
  primeContract          PrimeContract?
  projectScheduleEntries ProjectScheduleEntry[]
  primeChangeOrders      PrimeChangeOrder[]
  rfqs                   RFQ[]
  purchaseOrders         PurchaseOrder[]
  teamMembers            ProjectTeamAssignment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([stageId])
  @@index([statusId])
  @@index([division])
  @@index([gcId])
  @@index([leadPMId])
  @@index([effectiveStartDate])
  @@index([effectiveEndDate])
}

model ProjectStage {
  id          String    @id
  name        String    @unique
  code        String    @unique
  description String?
  color       String
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// enum ADDED BY ME
enum ProjectDivision {
  SCA
  DDC
  CIVIL
  INSTITUTIONAL
}

model ProjectStatus {
  id        String    @id
  name      String    @unique
  label     String
  color     String
  order     Int       @unique
  isDefault Boolean   @default(false)
  projects  Project[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PrimeContract {
  id                      String        @id
  project                 Project       @relation(fields: [projectId], references: [id])
  projectId               String        @unique
  contractValue           Decimal
  contractType            String?
  totalContractValue      Decimal?
  retainagePercent        Decimal?      @db.Decimal(5, 2)
  targetBudgetPercent     Decimal?      @db.Decimal(5, 2)
  paymentTerms            PaymentTerms?
  estimatedStartDate      DateTime?
  estimatedCompletionDate DateTime?
  actualStartDate         DateTime?
  actualCompletionDate    DateTime?
  executedContractDoc     File?         @relation(fields: [executedContractDocId], references: [id])
  executedContractDocId   String?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model ProjectTeamAssignment {
  projectId  String
  employeeId String
  role       String
  project    Project   @relation(fields: [projectId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@id([projectId, employeeId])
}

model ProjectScheduleEntry {
  id                 String            @id
  project            Project           @relation(fields: [projectId], references: [id])
  projectId          String
  date               DateTime
  description        String
  adjustedStartDate  DateTime?
  adjustedFinishDate DateTime?
  notes              String?
  file               File?             @relation(fields: [fileId], references: [id])
  fileId             String?
  changeOrder        PrimeChangeOrder? @relation(fields: [changeOrderId], references: [id])
  changeOrderId      String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId])
}

model ChangeOrderStatus {
  id        String    @id
  name      String    @unique
  label     String
  color     String
  order     Int       @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  primeChangeOrders   PrimeChangeOrder[]
  fromStatusHistories PCOStatusHistory[] @relation("FromStatus")
  toStatusHistories   PCOStatusHistory[] @relation("ToStatus")
}

enum ChangeOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PCOChangeType {
  id                String             @id
  name              String             @unique
  code              String             @unique
  description       String?
  color             String
  order             Int                @unique
  primeChangeOrders PrimeChangeOrder[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PrimeChangeOrder {
  id             String            @id
  project        Project           @relation(fields: [projectId], references: [id])
  projectId      String
  pcoNumber      String            @unique
  date           DateTime
  title          String
  description    String
  amount         Float
  status         ChangeOrderStatus @relation(fields: [statusId], references: [id])
  statusId       String
  revisionNumber Int               @default(1)

  creator   User   @relation(fields: [createdBy], references: [id])
  createdBy String

  markupAmount       Float?
  scheduleImpactDays Int?
  requestedBy        String?

  estimatedCost          Float?
  estimatedMargin        Float?
  estimatedMarginPercent Float?

  changeType      PCOChangeType?      @relation(fields: [changeTypeId], references: [id])
  changeTypeId    String?
  priority        ChangeOrderPriority @default(MEDIUM)
  impactsSchedule Boolean             @default(false)
  costCode        CostCode?           @relation(fields: [costCodeId], references: [id])
  costCodeId      String?
  contact         Contact?            @relation(fields: [contactId], references: [id])
  contactId       String?

  supersededByOrder PrimeChangeOrder?  @relation("PCOSupersedes", fields: [supersededBy], references: [id])
  supersededBy      String?
  supersededOrders  PrimeChangeOrder[] @relation("PCOSupersedes")

  lineItems       PrimeCOLineItem[]
  scheduleEntries ProjectScheduleEntry[]
  attachments     PCOAttachment[]
  statusHistory   PCOStatusHistory[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, statusId, date])
  @@index([pcoNumber])
}

model PCOStatusHistory {
  id           String              @id
  pco          PrimeChangeOrder    @relation(fields: [pcoId], references: [id])
  pcoId        String
  fromStatusId String?
  fromStatus   ChangeOrderStatus?  @relation("FromStatus", fields: [fromStatusId], references: [id])
  toStatusId   String
  toStatus     ChangeOrderStatus   @relation("ToStatus", fields: [toStatusId], references: [id])
  changedBy    String
  onBehalfOf   String?
  reason       String?
  createdAt    DateTime            @default(now())

  @@index([pcoId])
}

model PCOAttachment {
  id         String           @id
  pco        PrimeChangeOrder @relation(fields: [pcoId], references: [id])
  pcoId      String
  document   File             @relation(fields: [documentId], references: [id])
  documentId String
  createdAt  DateTime         @default(now())

  @@index([pcoId])
}

model PrimeCOLineItem {
  id             String           @id
  primeCo        PrimeChangeOrder @relation(fields: [primeCoId], references: [id])
  primeCoId      String           @map("primeCoid")
  sequenceNumber Int
  title          String
  description    String
  qty            Float
  unit           String
  unitPrice      Float
  amount         Float
  costCodeId     String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([primeCoId, sequenceNumber])
  @@index([primeCoId])
}

model RFQ {
  id        String  @id
  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @unique

  title String

  awardedVendor   Vendor?  @relation(fields: [awardedVendorid], references: [id])
  awardedVendorid String?
  awardedAmount   Decimal? @db.Decimal(15, 2)

  costCodeId String
  deadline   DateTime

  status RFQStatus

  createdBy String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rfqdeliverables RFQDeliverable[]

  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
}

enum RFQStatus {
  OPEN
  CLOSE
}

model RFQDeliverable {
  id         String    @id
  rfq        RFQ       @relation(fields: [rfqId], references: [id])
  rfqId      String
  title      String
  unit       String
  quantity   Int
  costCodeId String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model VendorQuotation {
  id        String          @id
  rfq       RFQ             @relation(fields: [rfqId], references: [id])
  rfqId     String
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  vendorId  String
  amount    Decimal
  leadTime  String
  status    QuotationStatus
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum QuotationStatus {
  WAITING
  ACCEPTED
  REJECTED
}

model PurchaseOrder {
  id        String  @id
  rfq       RFQ?    @relation(fields: [rfqId], references: [id])
  rfqId     String?
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  vendorId  String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  amount   Decimal
  leadTime String
  status   PurchaseOrderStatus

  issueDate    DateTime
  expectedDate DateTime
  deliveryDate DateTime

  address String

  createdBy String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lineItems PurchaseOrderLineItem[]

  purchaseOrderCOs PurchaseOrderCO[]

  invoices Invoice[]
}

enum PurchaseOrderStatus {
  DELIVERED
}

model PurchaseOrderLineItem {
  id              String        @id
  title           String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  unit            String
  quantity        Int
  costCodeId      String
  price           Decimal
  amount          Decimal
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PurchaseOrderCO {
  id                       String                    @id
  title                    String
  reason                   String
  purchaseOrder            PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId          String
  total                    Decimal
  deletedAt                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  purchaseOrderCOLineItems PurchaseOrderCOLineItem[]
}

model PurchaseOrderCOLineItem {
  id         String          @id
  pco        PurchaseOrderCO @relation(fields: [pcoId], references: [id])
  pcoId      String
  unit       String
  quantity   Int
  costCodeId String
  price      Decimal
  amount     Decimal
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Invoice {
  id              String        @id
  title           String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  status          InvoiceStatus
  amount          Decimal
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  REJECTED
}
