model RecurringBillRule {
  id String @id

  realmId String

  name String

  qbVendorId String
  vendorName String

  bankAccountId   String?
  bankAccountName String?

  categoryId   String?
  categoryName String?

  frequency      RecurringBillFrequency
  interval       Int                         @default(1)
  anchorDate     DateTime                    @db.Date
  scheduleTiming RecurringBillScheduleTiming
  dayOfMonth     Int?
  dayOfWeek      Int?

  amountMode    RecurringBillAmountMode
  defaultAmount Decimal?                @db.Decimal(15, 2)

  descriptionTemplate String? @db.Text
  memoTemplate        String? @db.Text

  isActive Boolean @default(true)

  startsOn DateTime? @db.Date
  endsOn   DateTime? @db.Date

  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  occurrences RecurringBillOccurrence[]
  payments    RecurringBillPayment[]

  @@index([realmId, deletedAt])
  @@index([realmId, isActive])
  @@index([qbVendorId])
}

model RecurringBillOccurrence {
  id String @id

  rule   RecurringBillRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleId String

  cycleKey String
  dueDate  DateTime @db.Date

  status        RecurringBillOccurrenceStatus @default(DUE)
  plannedAmount Decimal?                      @db.Decimal(15, 2)

  skippedAt   DateTime?
  skippedById String?
  skipReason  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment RecurringBillPayment?

  @@unique([ruleId, cycleKey])
  @@index([ruleId])
  @@index([dueDate])
  @@index([status])
}

model RecurringBillPayment {
  id String @id

  rule   RecurringBillRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleId String

  occurrence   RecurringBillOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  occurrenceId String?                  @unique

  cycleKey String
  amount   Decimal  @db.Decimal(15, 2)
  txnDate  DateTime @db.Date

  qbVendorId    String
  bankAccountId String
  categoryId    String

  transactionId      String
  transactionUrl     String
  quickBooksResponse Json?

  printLater Boolean @default(false)

  description String @db.Text
  memo        String? @db.Text

  invoiceDocumentId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ruleId, cycleKey])
  @@index([ruleId])
  @@index([txnDate])
  @@index([invoiceDocumentId])
}

enum RecurringBillFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM_MONTHLY
}

enum RecurringBillScheduleTiming {
  START_OF_MONTH
  DAY_OF_MONTH
  END_OF_MONTH
  DAY_OF_WEEK
  ANCHOR_DATE
}

enum RecurringBillAmountMode {
  FIXED
  VARIABLE
}

enum RecurringBillOccurrenceStatus {
  DUE
  PAID
  SKIPPED
  CANCELLED
  FAILED
}
