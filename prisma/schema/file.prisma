model File {
  id          String  @id
  name        String
  displayName String?

  objectId String?
  mimeType String?
  size     Int?

  parent   File?   @relation(fields: [parentId], references: [id], name: "parent", onDelete: Restrict)
  parentId String?

  children File[] @relation(name: "parent")

  type                FileType
  protectedFolderType ProtectedFolderType?

  isDeletable Boolean @default(true)

  private Boolean @default(false)

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  deletedBy String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendorDocuments   VendorDocument[]
  gcDocuments       GCDocument[]
  employeeDocuments EmployeeDocument[]
  primeContracts    PrimeContract[]

  projectSchedules ProjectSchedule[]

  rfqattachments RFQAttachment[]

  vendorQuoteAttachments VendorQuoteAttachment[]

  poattachments POAttachment[]
}

enum FileType {
  FILE
  FOLDER
}

enum ProtectedFolderType {
  PROJECT_ROOT
  INVOICE
  RFQ
  PURCHASE_ORDER
  PURCHASE_ORDER_CO
  PRIME_CO
  PRIME_CONTRACT
  SCHEDULE
}

model FileAccess {
  fileId String
  userId String

  permissions FilePermission[]

  @@id([fileId, userId])
}

enum FilePermission {
  DELETE
  READ
  DOWNLOAD
  CHANGE_PERMISSION
  ACCESS
  CREATE_FILE_WITHIN
}
