model File {
  id          String  @id
  name        String
  displayName String?

  objectId String?
  mimeType String?
  size     Int?

  parent   File?   @relation(fields: [parentId], references: [id], name: "parent", onDelete: Restrict)
  parentId String?

  children File[] @relation(name: "parent")

  type                FileType
  protectedFolderType ProtectedFolderType?

  isDeletable Boolean @default(true)

  private Boolean @default(false)

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  deletedBy String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendorDocuments   VendorDocument[]
  gcDocuments       GCDocument[]
  employeeDocuments EmployeeDocument[]
  primeContracts    PrimeContract[]

  projectSchedules ProjectSchedule[]

  rfqattachments RFQAttachment[]

  vendorQuoteAttachments VendorQuoteAttachment[]

  poattachments POAttachment[]

  scoattachments SCOAttachment[]

  invoiceAttachments InvoiceAttachment[]

  exportJobs FileExportJob[] @relation("FileExportFolder")
}

enum FileType {
  FILE
  FOLDER
}

enum ProtectedFolderType {
  PROJECT_ROOT
  INVOICE
  RFQ
  PURCHASE_ORDER
  PURCHASE_ORDER_CO
  PRIME_CO
  SUB_CHANGE_ORDER
  PRIME_CONTRACT
  SCHEDULE
}

model FileAccess {
  fileId String
  userId String

  permissions FilePermission[]

  @@id([fileId, userId])
}

enum FilePermission {
  DELETE
  READ
  DOWNLOAD
  CHANGE_PERMISSION
  ACCESS
  CREATE_FILE_WITHIN
}

model FileExportJob {
  id String @id

  folder   File   @relation("FileExportFolder", fields: [folderId], references: [id], onDelete: Restrict)
  folderId String

  status FileExportStatus @default(PENDING)

  fileName String
  objectId String?

  totalFiles     Int    @default(0)
  processedFiles Int    @default(0)
  totalBytes     String @default("0")
  processedBytes String @default("0")

  error String?

  createdBy String

  expiresAt   DateTime
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([folderId])
  @@index([createdBy])
  @@index([status])
  @@index([expiresAt])
}

enum FileExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}
