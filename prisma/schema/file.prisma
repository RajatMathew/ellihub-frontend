model File {
  id   String @id
  name String

  objectId String?
  mimeType String?
  size     Int?

  parent   File?   @relation(fields: [parentId], references: [id], name: "parent", onDelete: Restrict)
  parentId String?

  children File[] @relation(name: "parent")

  type FileType

  isDeletable Boolean @default(true)

  private Boolean @default(false)

  createdBy String
  deletedBy String?

  primeContract              PrimeContract?
  primeContractAttachment    PrimeContractAttachment?
  scheduleEntry              ProjectScheduleEntry?
  pcoAttachment              PCOAttachment?
  poAttachment               POAttachment?
  scoAttachment              SCOAttachment?
  rfqAttachment              RFQAttachment?
  quoteAttachment            QuoteAttachment?
  invoiceAttachment          InvoiceAttachment?
  invoice                    Invoice?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum FileType {
  FILE
  FOLDER
}

model FileAccess {
  fileId String
  userId String

  permissions FilePermission[]

  @@id([fileId, userId])
}

enum FilePermission {
  DELETE
  READ
  DOWNLOAD
  CHANGE_PERMISSION
  ACCESS
  CREATE_FILE_WITHIN
}
