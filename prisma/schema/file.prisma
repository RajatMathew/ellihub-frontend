model File {
  id   String @id
  name String

  objectId String?
  mimeType String?
  size     Int?

  parent   File?   @relation(fields: [parentId], references: [id], name: "parent", onDelete: Restrict)
  parentId String?

  children File[] @relation(name: "parent")

  type                FileType
  protectedFolderType ProtectedFolderType?

  isDeletable Boolean @default(true)

  private Boolean @default(false)

  createdBy String
  deletedBy String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendorDocuments VendorDocument[]
}

enum FileType {
  FILE
  FOLDER
}

enum ProtectedFolderType {
  PROJECT_ROOT
  INVOICE
  RFQ
  PURCHASE_ORDER
  PURCHASE_ORDER_CO
  PRIME_CO
  PRIME_CONTRACT
}

model FileAccess {
  fileId String
  userId String

  permissions FilePermission[]

  @@id([fileId, userId])
}

enum FilePermission {
  DELETE
  READ
  DOWNLOAD
  CHANGE_PERMISSION
  ACCESS
  CREATE_FILE_WITHIN
}
