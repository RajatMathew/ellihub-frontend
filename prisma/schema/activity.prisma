model ActivityLog {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  entityType String
  entityId   String

  action      String
  description String
  note        String?
  revision    Int?
  details     Json?

  affectedEntityIds String[] @default([])

  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  deletedBy String?

  @@index([userId])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([entityType, entityId, revision])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("activityLog")
}
