model ActivityLog {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  entityType String
  entityId   String

  action      String
  description String
  note        String?

  affectedEntityIds String[] @default([])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activityLog")
}
