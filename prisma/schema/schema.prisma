generator client {
  provider = "prisma-client"
  output   = "../../src/lib/db"
}

datasource db {
  provider = "postgresql"
}

model Configuration {
  id     String  @id
  name   String
  value  String
  type   String
  parent String?
  child  String?
  key1   String?
  key2   String?
}

model Lookup {
  id    String @id
  type  String
  label String

  contacts            Contact[]
  vendors             Vendor[]
  generalContractors  GeneralContractor[]
  departmentEmployees DepartmentEmployee[]

  @@unique([type, label])
}
