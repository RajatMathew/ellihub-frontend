generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "directory", "project"]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  projectManagers ProjectManager[]

  @@schema("directory")
}
