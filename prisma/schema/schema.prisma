generator client {
  provider = "prisma-client"
  output   = "../../src/lib/db"
}

datasource db {
  provider = "postgresql"
}

model Configuration {
  id     String  @id
  name   String
  value  String
  type   String
  parent String?
  child  String?
  key1   String?
  key2   String?
}

model Lookup {
  id    String @id
  type  String
  label String

  contacts            Contact[]
  vendors             Vendor[]
  generalContractors  GeneralContractor[]
  departmentEmployees DepartmentEmployee[]
  projectStages       Project[]            @relation("project_stage")
  projectDivisions    Project[]            @relation("project_division")
  rfqs                RFQ[]
  rfqdeliverables     RFQDeliverable[]

  @@unique([type, label])
}

enum PaymentTerms {
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  DUE_ON_RECEIPT
}
