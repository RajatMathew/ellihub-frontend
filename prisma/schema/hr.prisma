model Employee {
  id          String    @id
  name        String
  email       String    @unique
  phoneNumber String
  userId      String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Department {
  id          String  @id
  name        String  @unique
  description String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}
