model Employee {
  id                       String    @id
  name                     String
  email                    String    @unique
  phoneNumber              String
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  address                  String?
  startDate                DateTime?
  userId                   String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  status EmployeeStatus @default(ACTIVE)

  departments  DepartmentEmployee[]
  documents    EmployeeDocument[]
  leadProjects Project[]
  projectTeams ProjectTeamMember[]
  paidTimeOffs PaidTimeOff[]
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
}

model EmployeeDocument {
  id         String   @id
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  expiresOn DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, fileId])
  @@index([fileId])
}

model DepartmentEmployee {
  employeeId   String
  departmentId String
  role         Lookup     @relation(fields: [roleId], references: [id])
  roleId       String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@id([employeeId, departmentId])
}

model Department {
  id          String  @id
  name        String  @unique
  description String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employees DepartmentEmployee[]

  @@index([name])
}

model PaidTimeOff {
  id         String   @id
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     String
  type       Lookup   @relation(fields: [typeId], references: [id])
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  reason     String?
  status     PTOStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([employeeId])
  @@index([typeId])
  @@index([status])
}

enum PTOStatus {
  APPROVED
  REJECTED
  PENDING
}
