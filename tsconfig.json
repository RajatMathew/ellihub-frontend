{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Mirrors the aliases in tsconfig.app.json. This file is the one `bun test`
  // reads, and without them a module under test can only reach another module
  // through a relative climb — so the aliases decided what was testable.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@core/*": ["./src/core/*"],
      "@modules/*": ["./src/modules/*"]
    }
  }
}
