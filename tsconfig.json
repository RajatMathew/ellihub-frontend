{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@utils": ["src/utils"]
    }
  }
}
